# luispardo.com — configuración para Apache (SiteGround y similares)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS y www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.luispardo.com/$1 [R=301,L]

  # Páginas de la web antigua que ahora viven dentro de otras (301 = permanente)
  RewriteRule ^inicio/?$ / [R=301,L]
  RewriteRule ^spiritcocktailsbcn/?$ /spirit-club-bcn/#cocteleria [R=301,L,NE]
  RewriteRule ^sala-museo/?$ /spirit-club-bcn/ [R=301,L]
  RewriteRule ^television/?$ /el-mentalista/#television [R=301,L,NE]
  RewriteRule ^luis-pardo-mentalista-y-chatgpt/?$ /luna-iae/#historia [R=301,L,NE]
  RewriteRule ^el-clan-secreto/?$ /curso/#clan-secreto [R=301,L,NE]
  RewriteRule ^clases-secretas/?$ /curso/#clan-secreto [R=301,L,NE]
  RewriteRule ^psiquemagia(-feliz)?/?$ /curso/#psiquemagia [R=301,L,NE]
  RewriteRule ^curso-prueba/?$ /curso/ [R=301,L]
  RewriteRule ^dossier-dejar-de-fumar/?$ /dejar-de-fumar/#dossier [R=301,L,NE]
  RewriteRule ^(audio-gratuito-del-mpma|hipno-audio-de-muestra|hipnoaudio-de-muestra-mpma|gracias-mpma)/?$ /mpma/#muestra [R=301,L,NE]
  RewriteRule ^(hipnoaudio-de-muestra-formulario|hipnoaudio-de-muestra-hipnoaudios|gracias-hipnoaudios)/?$ /hipnoaudios-personalizados/#muestra [R=301,L,NE]
  RewriteRule ^formulario-te-voy-a-leer-la-mente/?$ /voy-a-entrar-en-tu-mente/#leer-la-mente [R=301,L,NE]
  RewriteRule ^regala-emociones/?$ /comprar_entradas/ [R=301,L]
  RewriteRule ^el-clan-de-la-hipnosis/?$ /espectaculos-anteriores/ [R=301,L]
  RewriteRule ^comment-page-[0-9]+/?$ /#opiniones [R=301,L,NE]
  RewriteRule ^feed/?$ / [R=301,L]
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
