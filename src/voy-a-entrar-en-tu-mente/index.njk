{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero" data-lantern>
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="object-position:center 25%"></div>
    <div class="hero-lantern" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Universo</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="grid-2" style="align-items:start">
        <div data-reveal>
          <div class="video vertical" data-video="../assets/media/voy-a-entrar-en-tu-mente.mp4">
            <img {{ c.seccion_2.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.seccion_2.video.titulo | texto }}</span></button>
          </div>
        </div>
        <div class="card trick" data-trick data-reveal style="--d:.1s">
          <span class="eyebrow center">{{ c.seccion_2.dejame_leerte_mente.antetitulo | texto }}</span>
          <h2 class="h3 mt-1">{{ c.seccion_2.dejame_leerte_mente.titulo | titulo }}</h2>
          <div class="trick-stage">
            <div class="trick-cards" aria-live="polite">
              <div class="pcard back"></div><div class="pcard back"></div><div class="pcard back"></div><div class="pcard back"></div><div class="pcard back"></div><div class="pcard back"></div>
            </div>
          </div>
          <p class="trick-msg" aria-live="polite">Seis cartas boca abajo. Cuando estés preparado, dales la vuelta.</p>
          <button class="btn btn-gold trick-btn" type="button">Empezar</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.mentalismo_con_los.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.mentalismo_con_los.titulo | titulo }}</h2>
      </div>
      <div class="wrap-narrow" data-reveal>
        <div class="video" data-video="../assets/media/experiencias-en-la-calle.mp4">
          <img {{ c.mentalismo_con_los.video.portada | img }} alt="" loading="lazy">
          <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.mentalismo_con_los.video.titulo | texto }}</span></button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="leer-la-mente">
    <div class="wrap">
      <div class="grid-2" style="align-items:start">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.leer_mente.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.leer_mente.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.leer_mente.entradilla | md }}</p>
          </div>
          <div class="row" data-reveal style="--d:.3s">
            <a class="btn btn-ghost" {{ c.leer_mente.boton.enlace | enlace }}>{{ c.leer_mente.boton.texto | texto }}</a>
            <a class="btn btn-ghost" {{ c.leer_mente.boton_2.enlace | enlace }}>{{ c.leer_mente.boton_2.texto | texto }}</a>
          </div>
        </div>
        <form class="card form" data-brevo data-success="¡Preparado! Revisa tu correo (y la carpeta de spam): ahí te espera tu HipnoAudio." method="POST" action="https://446471f7.sibforms.com/serve/MUIFAKFJ2h__JYZ1rBWTUqs0zEsIQ9KGLkiPeGEXxHc3Iz5zUlakIizr57IdCbgHe7pkwT9Hg2kxWL7DenyukLDQQ9pmd3XUC4ouOjhJ1LtaNO65z3iHmzwrgQauy5HUJQ3knfvtsxusrjOoin43bRqfMIUEeUKmIw0N6oVboMy9ybTwTuxbyAO15aEcsqG51C8NRVkU3ilIpY4-" data-reveal style="--d:.1s">
          <div class="form-row">
            <div class="field"><label for="v-nombre">Nombre</label><input id="v-nombre" name="NOMBRE" autocomplete="given-name" required></div>
            <div class="field"><label for="v-apellidos">Apellidos</label><input id="v-apellidos" name="APELLIDOS" autocomplete="family-name"></div>
          </div>
          <div class="field"><label for="v-email">Email</label><input id="v-email" type="email" name="EMAIL" autocomplete="email" required></div>
          <label class="check"><input type="checkbox" name="OPT_IN" value="1" required><span>Estoy preparado/a. Acepto la <a href="../politica-de-privacidad/">política de privacidad</a>.</span></label>
          <input class="hp" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="locale" value="es">
          <button class="btn btn-blood btn-block" type="submit">Léeme la mente</button>
          <div class="form-msg" role="status"></div>
        </form>
      </div>
    </div>
  </section>
</main>
{% endblock %}
