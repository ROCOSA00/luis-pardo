{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero" data-lantern>
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="hero-lantern" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Experiencias</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
        <div class="row" data-reveal style="--d:.3s">
          <a class="btn btn-blood btn-lg" {{ c.cabecera.boton.enlace | enlace }}>{{ c.cabecera.boton.texto | texto }}</a>
          <span class="badge">{{ c.cabecera.etiqueta | md({negrita: "b"}) }}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.necesario_creer_algo.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.necesario_creer_algo.titulo | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.necesario_creer_algo.texto | mdBloque }}</div>
        </div>
        <div data-reveal="right">
          <div class="frame frame-wide frame-deco"><img {{ c.necesario_creer_algo.imagen.src | img }} alt="{{ c.necesario_creer_algo.imagen.alt | texto }}" loading="lazy"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.una_conexion_directa.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.una_conexion_directa.titulo | titulo }}</h2>
        <p class="lead" data-reveal style="--d:.2s">{{ c.una_conexion_directa.entradilla | md }}</p>
      </div>
      <div class="grid-4">
        <div class="card" data-reveal>
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2v9"/><path d="M12 11l-3 6h6z"/><circle cx="12" cy="20" r="1.5"/></svg></div>
          <h3 class="h3">{{ c.una_conexion_directa.pendulo.titulo | titulo }}</h3>
          <p>{{ c.una_conexion_directa.pendulo.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.1s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 10h1M11 10h1M15 10h1M7 14h10"/></svg></div>
          <h3 class="h3">{{ c.una_conexion_directa.tablero_espiritista.titulo | titulo }}</h3>
          <p>{{ c.una_conexion_directa.tablero_espiritista.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.2s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 6l3 3"/></svg></div>
          <h3 class="h3">{{ c.una_conexion_directa.escritura_espiritista.titulo | titulo }}</h3>
          <p>{{ c.una_conexion_directa.escritura_espiritista.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.3s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M8 12c1.5-2 6.5-2 8 0-1.5 2-6.5 2-8 0z"/></svg></div>
          <h3 class="h3">{{ c.una_conexion_directa.viaje_extatico.titulo | titulo }}</h3>
          <p>{{ c.una_conexion_directa.viaje_extatico.texto | md }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div class="frame frame-deco" data-reveal="left"><img {{ c.llevas_pendulo_tablero.imagen.src | img }} alt="{{ c.llevas_pendulo_tablero.imagen.alt | texto }}" loading="lazy" style="aspect-ratio:3/2"></div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.llevas_pendulo_tablero.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.llevas_pendulo_tablero.titulo | titulo }}</h2>
          </div>
          <p class="lead" data-reveal style="--d:.2s">{{ c.llevas_pendulo_tablero.entradilla | md }}</p>
        </div>
      </div>

      <div class="grid-2 mt-4">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.llevas_pendulo_tablero.antetitulo_2 | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.llevas_pendulo_tablero.titulo_2 | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.llevas_pendulo_tablero.texto | mdBloque }}</div>
        </div>
        <div class="frame frame-deco order-first-mobile" data-reveal="right"><img {{ c.llevas_pendulo_tablero.imagen_2.src | img }} alt="{{ c.llevas_pendulo_tablero.imagen_2.alt | texto }}" loading="lazy" style="aspect-ratio:565/655"></div>
      </div>
    </div>
  </section>

  <section class="section bg-vignette" id="solicitar">
    <div class="wrap">
      <div class="grid-2" style="align-items:start">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.solicitar.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.solicitar.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.solicitar.entradilla | md }}</p>
          </div>
          <div class="price-tag" data-reveal style="--d:.25s"><span class="now">{{ c.solicitar.texto | texto }}</span><span class="per">{{ c.solicitar.texto_2 | texto }}</span></div>
          <div class="notice" data-reveal style="--d:.3s">{{ c.solicitar.aviso | md }}</div>
          <p class="muted" data-reveal style="--d:.35s">{{ c.solicitar.texto_3 | md }}</p>
        </div>
        <form class="card form" data-brevo data-success="¡Solicitud enviada! Te contactaremos para concretar día y hora de tu sesión." method="POST" action="https://446471f7.sibforms.com/serve/MUIFAEWHV-LeHFOf1XiQxmD9BQIu3dP6Z-898aKi7oNK4-rEorgVSqooAvAgFmNP2Gn4SZLueYPJN61T3xwFDWjl4yFDl23n85n2KXcWzb90V7VelfegXvd4M-9Fffak96nbn6D20SVUqszu9nIavgftJcE4e_D6tvGfOGkTFM0RRYknEY8y2YrpoWWEqp4JYqp1SvPnejoiz88Q" data-reveal style="--d:.1s">
          <div class="form-row">
            <div class="field"><label for="s-nombre">Nombre</label><input id="s-nombre" name="NOMBRE" autocomplete="given-name" required></div>
            <div class="field"><label for="s-apellidos">Apellidos</label><input id="s-apellidos" name="APELLIDOS" autocomplete="family-name"></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="s-email">Email</label><input id="s-email" type="email" name="EMAIL" autocomplete="email" required></div>
            <div class="field"><label for="s-tel">Teléfono</label><input id="s-tel" type="tel" name="TELEFONO" autocomplete="tel" required></div>
          </div>
          <div class="field"><label for="s-edad">Edad</label><input id="s-edad" type="number" name="EDAD" min="18" max="120" required><span class="form-note">Imprescindible ser mayor de edad.</span></div>
          <div class="field"><label for="s-msg">¿Con quién te gustaría contactar?</label><textarea id="s-msg" name="PORQUE_QUIERES_PERTENECER_AL_CLUB" required></textarea></div>
          <label class="check"><input type="checkbox" name="OPT_IN" value="1" required><span>Acepto las condiciones, la <a href="../politica-de-privacidad/">política de privacidad</a> y recibir sus newsletters.</span></label>
          <input class="hp" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="locale" value="es">
          <button class="btn btn-blood btn-block" type="submit">Solicitar sesión</button>
          <div class="form-msg" role="status"></div>
        </form>
      </div>
    </div>
  </section>
</main>
{% endblock %}
