{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Experiencias</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
        <div class="row" data-reveal style="--d:.3s">
          <a class="btn btn-blood btn-lg" href="mailto:{{ ajustes.email }}?subject=Evento%20de%20empresa">{{ c.cabecera.boton | texto }}</a>
          <a class="btn btn-whatsapp btn-lg" href="{{ c.cabecera.boton_2.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.cabecera.boton_2.texto | texto }}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.maestro_mas_dificil.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.maestro_mas_dificil.titulo | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.maestro_mas_dificil.texto | mdBloque }}</div>
        </div>
        <ol class="steps" data-reveal="right">
          <li><div><h3>{{ c.maestro_mas_dificil.cuentanos_evento.titulo | titulo }}</h3><p>{{ c.maestro_mas_dificil.cuentanos_evento.texto | md }}</p></div></li>
          <li><div><h3>{{ c.maestro_mas_dificil.disenamos_experiencia.titulo | titulo }}</h3><p>{{ c.maestro_mas_dificil.disenamos_experiencia.texto | md }}</p></div></li>
          <li><div><h3>{{ c.maestro_mas_dificil.tus_invitados_olvidaran.titulo | titulo }}</h3><p>{{ c.maestro_mas_dificil.tus_invitados_olvidaran.texto | md }}</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="section-head center wrap">
      <span class="eyebrow center" data-reveal>{{ c.seccion_3.antetitulo | texto }}</span>
    </div>
    <div class="marquee" aria-label="Empresas clientes">
      <div class="marquee-track">{% for m in c.seccion_3.nombres %}<span>{{ m | texto }}</span>{% endfor %}{% for m in c.seccion_3.nombres %}<span aria-hidden="true">{{ m | texto }}</span>{% endfor %}</div>
    </div>
  </section>

  <section class="section cta-final">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <span class="eyebrow center" data-reveal>{{ c.hagamos_que_evento.antetitulo | texto }}</span>
      <h2 class="h2" data-reveal style="--d:.1s">{{ c.hagamos_que_evento.titulo | titulo }}</h2>
      <p class="lead" data-reveal style="--d:.2s">{{ c.hagamos_que_evento.entradilla | md }}</p>
      <div class="row center" data-reveal style="--d:.3s">
        <a class="btn btn-blood btn-lg" href="mailto:{{ ajustes.email }}?subject=Evento%20de%20empresa">{{ c.hagamos_que_evento.boton | texto }}</a>
        <a class="btn btn-whatsapp btn-lg" href="{{ c.hagamos_que_evento.boton_2.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.hagamos_que_evento.boton_2.texto | texto }}</a>
      </div>
    </div>
  </section>
</main>
{% endblock %}
