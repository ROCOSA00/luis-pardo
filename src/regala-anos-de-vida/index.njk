{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<meta name="robots" content="noindex">
{% endblock %}
{% block main %}
<main id="main">
  <section class="hero" data-lantern style="min-height:auto">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="opacity:.35"></div>
    <canvas class="embers" aria-hidden="true"></canvas>
    <div class="hero-lantern" aria-hidden="true"></div>
    <div class="wrap-narrow">
      <div class="hero-content center" style="max-width:none; justify-items:center">
        <span class="eyebrow center" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo("text-blood") }}</h1>
        <div class="countdown" data-countdown="666" data-reveal style="--d:.2s" aria-live="off">
          <div class="unit"><span class="val cd-min">11</span><span class="lbl">Min</span></div>
          <div class="unit"><span class="val cd-sec">06</span><span class="lbl">Seg</span></div>
        </div>
        <p class="lead" data-reveal style="--d:.3s">{{ c.cabecera.entradilla | md }}</p>
        <p class="notice red" data-countdown-over hidden>{{ c.cabecera.aviso | md }}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap-narrow stack-lg">
      <div class="prose" data-reveal>{{ c.seccion_2.texto | mdBloque }}</div>
      <div class="grid-3" data-reveal>
        <a class="btn btn-blood" href="{{ c.seccion_2.boton.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.seccion_2.boton.texto | texto }}</a>
        <a class="btn btn-blood" href="{{ c.seccion_2.boton_2.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.seccion_2.boton_2.texto | texto }}</a>
        <a class="btn btn-blood" href="{{ c.seccion_2.boton_3.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.seccion_2.boton_3.texto | texto }}</a>
        <a class="btn btn-ghost" href="{{ c.seccion_2.boton_4.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.seccion_2.boton_4.texto | texto }}</a>
        <a class="btn btn-ghost" href="{{ c.seccion_2.boton_5.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.seccion_2.boton_5.texto | texto }}</a>
        <a class="btn btn-ghost" href="{{ c.seccion_2.boton_6.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.seccion_2.boton_6.texto | texto }}</a>
      </div>
      <p class="form-note center" data-reveal>{{ c.seccion_2.texto_2 | md }}</p>
    </div>
  </section>
</main>
{% endblock %}
