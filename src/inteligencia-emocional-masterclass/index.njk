{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><a href="../curso/">Tu mente</a><span aria-hidden="true">/</span><span>Masterclass</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap stack-lg">
      <div class="grid-2" style="align-items:start">
        <div class="stack" data-reveal>
          <span class="eyebrow">{{ c.seccion_2.antetitulo | texto }}</span>
          <div class="video" data-video="../assets/media/masterclass-ie-1.mp4">
            <img {{ c.seccion_2.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.seccion_2.video.titulo | texto }}</span></button>
          </div>
          <p class="muted">{{ c.seccion_2.texto | md }}</p>
        </div>
        <div class="stack" data-reveal style="--d:.1s">
          <span class="eyebrow">{{ c.seccion_2.antetitulo_2 | texto }}</span>
          <div class="video" data-video="../assets/media/masterclass-ie-2.mp4">
            <img {{ c.seccion_2.video_2.portada | img }} alt="" loading="lazy" style="object-position:center 30%">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.seccion_2.video_2.titulo | texto }}</span></button>
          </div>
          <p class="muted">{{ c.seccion_2.texto_2 | md }}</p>
        </div>
      </div>
      <p class="quote-big center" data-reveal>{{ c.seccion_2.texto_3 | md }}</p>
    </div>
  </section>

  <section class="section bg-vignette">
    <div class="wrap">
      <div class="grid-2">
        <div class="frame frame-tall frame-deco" data-reveal="left" style="max-width:440px"><img {{ c.alquimia_mente.imagen.src | img }} alt="{{ c.alquimia_mente.imagen.alt | texto }}" loading="lazy"></div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.alquimia_mente.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.alquimia_mente.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.alquimia_mente.entradilla | md }}</p>
          </div>
          <div data-reveal style="--d:.25s">
            <h3 class="h3 mb-2">{{ c.alquimia_mente.titulo_2 | titulo }}</h3>
            <ul class="checklist">{% for p in c.alquimia_mente.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
          </div>
          <div data-reveal style="--d:.3s">
            <h3 class="h3 mb-2">{{ c.alquimia_mente.titulo_3 | titulo }}</h3>
            <ul class="pill-list">{% for p in c.alquimia_mente.puntos_2 %}<li>{{ p | md }}</li>{% endfor %}</ul>
          </div>
          <div class="card" data-reveal style="--d:.35s">
            <div class="price-tag"><span class="now">{{ c.alquimia_mente.bloque.texto | texto }}</span><span class="was">{{ c.alquimia_mente.bloque.texto_2 | texto }}</span><span class="per">{{ c.alquimia_mente.bloque.texto_3 | texto }}</span></div>
            <p class="mt-1">{{ c.alquimia_mente.bloque.texto_4 | md }}</p>
            <div class="row mt-2"><a class="btn btn-blood btn-lg" {{ c.alquimia_mente.bloque.boton.enlace | enlace }}>{{ c.alquimia_mente.bloque.boton.texto | texto }}</a></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-final">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <h2 class="h2" data-reveal>{{ c.esta_masterclass_sido.titulo | titulo }}</h2>
      <p class="lead" data-reveal style="--d:.1s">{{ c.esta_masterclass_sido.entradilla | md }}</p>
      <div class="row center" data-reveal style="--d:.2s">
        <a class="btn btn-blood btn-lg" {{ c.esta_masterclass_sido.boton.enlace | enlace }}>{{ c.esta_masterclass_sido.boton.texto | texto }}</a>
        <a class="btn btn-ghost btn-lg" {{ c.esta_masterclass_sido.boton_2.enlace | enlace }}>{{ c.esta_masterclass_sido.boton_2.texto | texto }}</a>
      </div>
    </div>
  </section>
</main>
{% endblock %}
