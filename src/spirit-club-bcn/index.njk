{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Experiencias</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
        <div class="row" data-reveal style="--d:.3s">
          <a class="btn btn-blood" {{ c.cabecera.boton.enlace | enlace }}>{{ c.cabecera.boton.texto | texto }}</a>
          <a class="btn btn-ghost" {{ c.cabecera.boton_2.enlace | enlace }}>{{ c.cabecera.boton_2.texto | texto }}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.para_crear_verdadera.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.para_crear_verdadera.titulo | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.para_crear_verdadera.texto | mdBloque }}</div>
        </div>
        <div data-reveal="right">
          <div class="video" data-youtube="{{ c.para_crear_verdadera.video.youtube | youtubeId }}" data-title="{{ c.para_crear_verdadera.video.titulo | texto }}">
            <img src="https://i.ytimg.com/vi/{{ c.para_crear_verdadera.video.youtube | youtubeId }}/hqdefault.jpg" width="480" height="360" alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.para_crear_verdadera.video.boton | texto }}</span></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="stats" data-reveal>{% for s in c.seccion_3.cifras %}<div class="stat"><span class="stat-num" {{ s.cifra | cifra }}>{{ s.cifra | texto }}</span><span class="stat-label">{{ s.texto | texto }}</span></div>{% endfor %}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.anticuario_perdido_tiempo.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.anticuario_perdido_tiempo.titulo | titulo }}</h2>
        <p class="lead" data-reveal style="--d:.2s">{{ c.anticuario_perdido_tiempo.entradilla | md }}</p>
      </div>
      <div class="masonry" data-lightbox data-reveal>{% for f in c.anticuario_perdido_tiempo.fotos %}<a href="{{ f.imagen | ruta }}"><img {{ f.imagen | img }} alt="{{ f.descripcion | texto }}" loading="lazy"></a>{% endfor %}</div>
      <div class="grid-3 mt-3">
        <div class="card" data-reveal>
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 21h18M5 21V9l7-5 7 5v12"/><path d="M9 21v-6h6v6"/></svg></div>
          <h3 class="h3">{{ c.anticuario_perdido_tiempo.dos_estancias.titulo | titulo }}</h3>
          <p>{{ c.anticuario_perdido_tiempo.dos_estancias.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.1s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14 20c0-2.5 1.5-4.5 3.5-4.5S21 17.5 21 20"/></svg></div>
          <h3 class="h3">{{ c.anticuario_perdido_tiempo.publico_publico.titulo | titulo }}</h3>
          <p>{{ c.anticuario_perdido_tiempo.publico_publico.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.2s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3l2 6h6l-5 4 2 7-5-4-5 4 2-7-5-4h6z"/></svg></div>
          <h3 class="h3">{{ c.anticuario_perdido_tiempo.fenomenos_psiquicos.titulo | titulo }}</h3>
          <p>{{ c.anticuario_perdido_tiempo.fenomenos_psiquicos.texto | md }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2" id="cocteleria">
    <div class="wrap">
      <div class="grid-2">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>Servicio de coctelería</span>
            <h2 class="h2" data-reveal style="--d:.1s">¿Te atreves a pecar con este trago?</h2>
            <p class="lead" data-reveal style="--d:.2s">Cócteles exclusivos, chupitos moleculares o tu bebida favorita mientras vives la experiencia.</p>
          </div>
          <p class="muted" data-reveal style="--d:.25s">Si quieres que la experiencia continúe en tu casa con un añadido sorpresa, pide el cóctel <strong class="gold">7 Pecados</strong>: en realidad es mucho más que un cóctel.</p>
          <div class="card" data-reveal style="--d:.3s">
            <span class="eyebrow">Desde el 22 de noviembre de 2022</span>
            <h3 class="h3 mt-1">Spirit Cocktails Bcn</h3>
            <p>La primera coctelería dedicada al espiritismo del mundo, de Luis Pardo y M. Minerva: magia y mentalismo a dos palmos, charlas sobre misterio, rutas paranormales que terminan con un cóctel exclusivo y música en directo.</p>
            <p class="mt-1"><strong class="gold">{{ ajustes.direccion }}</strong> · <a href="{{ ajustes.telefono | tel }}">{{ ajustes.telefono }}</a></p>
            <div class="row mt-2"><a class="btn btn-ghost btn-sm" href="http://www.spiritcocktailsbcn.com/" target="_blank" rel="noopener">spiritcocktailsbcn.com</a></div>
          </div>
        </div>
        <div class="grid-2" style="gap:16px" data-reveal="right">
          <div class="frame frame-tall"><img src="../assets/img/coctel-7-pecados.webp" width="1600" height="1550" alt="Cóctel 7 Pecados en una copa con forma de calavera" loading="lazy"></div>
          <div class="frame frame-tall" style="margin-top:40px"><img src="../assets/img/coctel.webp" width="1600" height="1626" alt="Barra de Spirit Club Bcn" loading="lazy"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-final">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <span class="eyebrow center" data-reveal>{{ c.mas_33_000.antetitulo | texto }}</span>
      <h2 class="h2" data-reveal style="--d:.1s">{{ c.mas_33_000.titulo | titulo }}</h2>
      <p class="lead" data-reveal style="--d:.2s">{{ c.mas_33_000.entradilla | md }}</p>
      <div class="row center" data-reveal style="--d:.3s"><a class="btn btn-blood btn-lg" {{ c.mas_33_000.boton.enlace | enlace }}>{{ c.mas_33_000.boton.texto | texto }}</a></div>
    </div>
  </section>
</main>
{% endblock %}
