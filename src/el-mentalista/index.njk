{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Luis Pardo</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div data-reveal="left">
          <div class="frame frame-square frame-deco"><img {{ c.apasionado_mente_todo.imagen.src | img }} alt="{{ c.apasionado_mente_todo.imagen.alt | texto }}" loading="lazy"></div>
        </div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.apasionado_mente_todo.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.apasionado_mente_todo.titulo | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.apasionado_mente_todo.texto | mdBloque }}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.tres_hitos_una.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.tres_hitos_una.titulo | titulo }}</h2>
      </div>
      <div class="awards">
        <div class="award" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4"/></svg>
          <div class="award-year">{{ c.tres_hitos_una.texto | md }}</div>
          <div class="award-title">{{ c.tres_hitos_una.texto_2 | md }}</div>
          <p class="award-desc">{{ c.tres_hitos_una.texto_3 | md }}</p>
        </div>
        <div class="award" data-reveal style="--d:.1s">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="17" r="3"/><path d="M5 4h4l3 7 3-7h4"/><path d="M12 11v3"/></svg>
          <div class="award-year">{{ c.tres_hitos_una.texto_4 | md }}</div>
          <div class="award-title">{{ c.tres_hitos_una.texto_5 | md }}</div>
          <p class="award-desc">{{ c.tres_hitos_una.texto_6 | md }}</p>
        </div>
        <div class="award" data-reveal style="--d:.2s">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
          <div class="award-year">{{ c.tres_hitos_una.texto_7 | md }}</div>
          <div class="award-title">{{ c.tres_hitos_una.texto_8 | md }}</div>
          <p class="award-desc">{{ c.tres_hitos_una.texto_9 | md }}</p>
        </div>
      </div>
      <div class="grid-2 mt-4">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.tres_hitos_una.antetitulo_2 | texto }}</span>
            <h3 class="h2" data-reveal style="--d:.1s">{{ c.tres_hitos_una.titulo_2 | titulo }}</h3>
          </div>
          <p class="lead" data-reveal style="--d:.2s">{{ c.tres_hitos_una.entradilla | md }}</p>
        </div>
        <div data-reveal="right">
          <div class="video" data-youtube="{{ c.tres_hitos_una.video.youtube | youtubeId }}" data-title="{{ c.tres_hitos_una.video.titulo | texto }}">
            <img src="https://i.ytimg.com/vi/{{ c.tres_hitos_una.video.youtube | youtubeId }}/hqdefault.jpg" width="480" height="360" alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.tres_hitos_una.video.boton | texto }}</span></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.teatro_television.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.teatro_television.titulo | titulo }}</h2>
      </div>
      <div class="grid-2" style="align-items:stretch">
        <div class="card" data-reveal>
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 4h18v6a9 9 0 0 1-18 0z"/><path d="M8 9h.01M16 9h.01M9 13c1.5 1.5 4.5 1.5 6 0"/></svg></div>
          <h3 class="h3">{{ c.teatro_television.teatro.titulo | titulo }}</h3>
          <p>{{ c.teatro_television.teatro.texto | md }}</p>
          <a class="link-arrow mt-2" {{ c.teatro_television.teatro.enlace.enlace | enlace }}>{{ c.teatro_television.teatro.enlace.texto | texto }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <div class="card" data-reveal style="--d:.1s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M8 3l4 3 4-3"/></svg></div>
          <h3 class="h3">{{ c.teatro_television.television.titulo | titulo }}</h3>
          <p>{{ c.teatro_television.television.texto | md }}</p>
          <a class="link-arrow mt-2" {{ c.teatro_television.television.enlace.enlace | enlace }}>{{ c.teatro_television.television.enlace.texto | texto }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>

      <div class="feature mt-4" data-reveal>
        <div class="grid-2">
          <div class="stack">
            <span class="eyebrow">{{ c.teatro_television.psiquemagia.antetitulo | texto }}</span>
            <h3 class="h2">{{ c.teatro_television.psiquemagia.titulo | titulo }}</h3>
            <p class="lead">{{ c.teatro_television.psiquemagia.entradilla | md }}</p>
            <p class="muted">{{ c.teatro_television.psiquemagia.texto | md }}</p>
          </div>
          <div class="frame frame-wide"><img {{ c.teatro_television.psiquemagia.imagen.src | img }} alt="{{ c.teatro_television.psiquemagia.imagen.alt | texto }}" loading="lazy"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-vignette">
    <div class="wrap">
      <div class="grid-2">
        <div class="frame frame-tall frame-deco" data-reveal="left"><img {{ c.minerva.imagen.src | img }} alt="{{ c.minerva.imagen.alt | texto }}" loading="lazy"></div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.minerva.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.minerva.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.minerva.entradilla | md }}</p>
          </div>
          <div class="prose" data-reveal style="--d:.25s">{{ c.minerva.texto | mdBloque({ enlace: "gold" }) }}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="television">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.television.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.television.titulo | titulo }}</h2>
        <p class="lead" data-reveal style="--d:.2s">{{ c.television.entradilla | md }}</p>
      </div>
      <div class="grid-2" style="align-items:start">
        <div class="timeline" data-reveal>{% for h in c.television.hitos %}<div class="timeline-item"><div class="timeline-year">{{ h.fecha | texto }}</div><div class="timeline-title">{{ h.titulo | texto }}</div>{% if h.texto %}<p>{{ h.texto | md }}</p>{% endif %}</div>{% endfor %}</div>
        <div class="stack-lg" data-reveal style="--d:.1s">
          <div class="frame frame-wide"><img {{ c.television.imagen.src | img }} alt="{{ c.television.imagen.alt | texto }}" loading="lazy"></div>
          <div class="card">
            <span class="eyebrow">{{ c.television.los_especiales_pardo.antetitulo | texto }}</span>
            <h3 class="h3 mt-1">{{ c.television.los_especiales_pardo.titulo | titulo }}</h3>
            <p>{{ c.television.los_especiales_pardo.texto | md }}</p>
          </div>
          <div class="video" data-video="../assets/media/experiencias-en-la-calle.mp4">
            <img {{ c.television.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.television.video.titulo | texto }}</span></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-final bg-2">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <h2 class="h2" data-reveal>{{ c.despues_cruzarte_con.titulo | titulo }}</h2>
      <div class="row center" data-reveal style="--d:.1s">
        <a class="btn btn-blood btn-lg" {{ c.despues_cruzarte_con.boton.enlace | enlace }}>{{ c.despues_cruzarte_con.boton.texto | texto }}</a>
        <a class="btn btn-ghost btn-lg" {{ c.despues_cruzarte_con.boton_2.enlace | enlace }}>{{ c.despues_cruzarte_con.boton_2.texto | texto }}</a>
      </div>
    </div>
  </section>
</main>
{% endblock %}
