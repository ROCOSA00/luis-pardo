{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:description" content="{{ c.seo.descripcion_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block headExtra %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TheaterEvent",
  "name": "Cuando el Diablo Piensa",
  "description": "Experiencia de mentalismo inmersiva para un máximo de 26 personas.",
  "performer": [{"@type": "Person", "name": "Luis Pardo"}, {"@type": "Person", "name": "M. Minerva"}],
  "location": {"@type": "Place", "name": "Spirit Club Bcn", "address": "Barcelona"},
  "offers": {"@type": "Offer", "url": "https://www.dinaticket.com/es/provider/17243/event/4843342"},
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode"
}
</script>
{% endblock %}
{% block main %}
<main id="main">
  <section class="hero" data-lantern>
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="object-position:right center; opacity:.6"></div>
    <canvas class="embers" aria-hidden="true"></canvas>
    <div class="hero-lantern" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-content">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Experiencias</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo("text-blood") }}</h1>
        <p class="hero-tagline" data-reveal style="--d:.2s">{{ c.cabecera.texto | md }}</p>
        <div class="hero-badges" data-reveal style="--d:.3s">
          <span class="badge badge-red">{{ c.cabecera.etiqueta | md({negrita: "b"}) }}</span>
          <span class="badge">{{ c.cabecera.etiqueta_2 | md({negrita: "b"}) }}</span>
          <span class="badge">{{ c.cabecera.etiqueta_3 | md({negrita: "b"}) }}</span>
          <span class="badge">{{ c.cabecera.etiqueta_4 | md({negrita: "b"}) }}</span>
        </div>
        <div class="row" data-reveal style="--d:.4s">
          <a class="btn btn-blood btn-lg" {{ ajustes.entradas.cedp | enlace }}>{{ c.cabecera.boton | texto }}</a>
          <a class="btn btn-ghost btn-lg" {{ c.cabecera.boton_2.enlace | enlace }}>{{ c.cabecera.boton_2.texto | texto }}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- El pacto -->
  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.cruzar_puerta_vienes.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.cruzar_puerta_vienes.titulo | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.cruzar_puerta_vienes.texto | mdBloque }}</div>
        </div>
        <div data-reveal="right">
          <div class="frame frame-deco" data-tilt><img {{ c.cruzar_puerta_vienes.imagen.src | img }} alt="{{ c.cruzar_puerta_vienes.imagen.alt | texto }}" loading="lazy"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tráiler -->
  <section class="section bg-2" id="trailer">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.trailer.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.trailer.titulo | titulo }}</h2>
      </div>
      <div class="grid-2" style="align-items:start">
        <div data-reveal>
          <div class="video" data-video="../assets/media/cedp-trailer.mp4">
            <img {{ c.trailer.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.trailer.video.titulo | texto }}</span></button>
          </div>
          <p class="video-caption">{{ c.trailer.texto | md }}</p>
        </div>
        <div data-reveal style="--d:.15s">
          <div class="video" data-video="../assets/media/ruleta-rusa-buenafuente.mp4">
            <img {{ c.trailer.video_2.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.trailer.video_2.titulo | texto }}</span></button>
          </div>
          <p class="video-caption">{{ c.trailer.texto_2 | md }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Qué vivirás -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.esto_para_cualquiera.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.esto_para_cualquiera.titulo | titulo }}</h2>
      </div>
      <div class="grid-4">
        <div class="card" data-reveal>
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></div>
          <h3 class="h3">{{ c.esto_para_cualquiera.telepatia.titulo | titulo }}</h3>
          <p>{{ c.esto_para_cualquiera.telepatia.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.1s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
          <h3 class="h3">{{ c.esto_para_cualquiera.predicciones.titulo | titulo }}</h3>
          <p>{{ c.esto_para_cualquiera.predicciones.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.2s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2c3 4 5 6 5 10a5 5 0 0 1-10 0c0-4 2-6 5-10z"/><path d="M12 14v8"/></svg></div>
          <h3 class="h3">{{ c.esto_para_cualquiera.energias.titulo | titulo }}</h3>
          <p>{{ c.esto_para_cualquiera.energias.texto | md }}</p>
        </div>
        <div class="card" data-reveal style="--d:.3s">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3a7 7 0 0 0-7 7v10l2.5-2 2.5 2 2-2 2 2 2.5-2 2.5 2V10a7 7 0 0 0-7-7z"/><circle cx="9.5" cy="10" r="1"/><circle cx="14.5" cy="10" r="1"/></svg></div>
          <h3 class="h3">{{ c.esto_para_cualquiera.espiritismo.titulo | titulo }}</h3>
          <p>{{ c.esto_para_cualquiera.espiritismo.texto | md }}</p>
        </div>
      </div>
      <div class="grid-2 mt-4">
        <ul class="checklist red" data-reveal>{% for p in c.esto_para_cualquiera.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
        <ul class="checklist" data-reveal style="--d:.1s">{% for p in c.esto_para_cualquiera.puntos_2 %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
      </div>
    </div>
  </section>

  <!-- Los guías -->
  <section class="section bg-vignette">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.dos_mentes_mismo.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.dos_mentes_mismo.titulo | titulo }}</h2>
      </div>
      <div class="grid-2" style="align-items:stretch">
        <article class="tarot" data-tilt data-reveal>
          <div class="tarot-media" style="aspect-ratio:4/3"><img {{ c.dos_mentes_mismo.luis_pardo.imagen.src | img }} alt="{{ c.dos_mentes_mismo.luis_pardo.imagen.alt | texto }}" loading="lazy"></div>
          <div class="tarot-body">
            <div class="tarot-meta">{% for d in c.dos_mentes_mismo.luis_pardo.datos %}<span>{{ d | texto }}</span>{% endfor %}</div>
            <h3>{{ c.dos_mentes_mismo.luis_pardo.titulo | titulo }}</h3>
            <p>{{ c.dos_mentes_mismo.luis_pardo.texto | md }}</p>
            <ul class="checklist">{% for p in c.dos_mentes_mismo.luis_pardo.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
          </div>
        </article>
        <article class="tarot" data-tilt data-reveal style="--d:.1s">
          <div class="tarot-media" style="aspect-ratio:4/3"><img {{ c.dos_mentes_mismo.minerva.imagen.src | img }} alt="{{ c.dos_mentes_mismo.minerva.imagen.alt | texto }}" loading="lazy" style="object-position:center 15%"></div>
          <div class="tarot-body">
            <div class="tarot-meta">{% for d in c.dos_mentes_mismo.minerva.datos %}<span>{{ d | texto }}</span>{% endfor %}</div>
            <h3>{{ c.dos_mentes_mismo.minerva.titulo | titulo }}</h3>
            <p>{{ c.dos_mentes_mismo.minerva.texto | md }}</p>
            <ul class="checklist">{% for p in c.dos_mentes_mismo.minerva.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
          </div>
        </article>
      </div>
      <p class="quote-big center mt-4" data-reveal>{{ c.dos_mentes_mismo.texto | md }}</p>
    </div>
  </section>

  <!-- Opiniones -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.n9_9_sobre.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.n9_9_sobre.titulo | titulo }}</h2>
        <p class="lead" data-reveal style="--d:.2s">{{ c.n9_9_sobre.entradilla | md }}</p>
      </div>
      <div class="grid-2" style="align-items:start">
        <div data-reveal>
          <div class="video vertical" data-video="../assets/media/cedp-opiniones.mp4">
            <img {{ c.n9_9_sobre.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.n9_9_sobre.video.titulo | texto }}</span></button>
          </div>
        </div>
        <div class="carousel" data-carousel data-autoplay="6000" data-reveal style="--d:.1s">
          <div class="carousel-track" style="grid-auto-columns:100%">{% for o in c.n9_9_sobre.opiniones %}<figure class="card vip-card"><blockquote>«{{ o.cita | md }}»</blockquote>{% if o.autor %}<figcaption class="who">{{ o.autor | texto }}</figcaption>{% endif %}</figure>{% endfor %}</div>
          <div class="carousel-nav">
            <div class="carousel-dots"></div>
            <button class="carousel-btn carousel-prev" type="button" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="carousel-btn carousel-next" type="button" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Info práctica -->
  <section class="section bg-2" id="entradas">
    <div class="wrap">
      <div class="grid-2" style="align-items:start">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.entradas.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.entradas.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.entradas.entradilla | md }}</p>
          </div>
          <div class="notice" data-reveal style="--d:.25s">{{ c.entradas.aviso | md }}</div>
          <div class="row" data-reveal style="--d:.3s">
            <a class="btn btn-blood btn-lg" {{ ajustes.entradas.cedp | enlace }}>{{ c.entradas.boton | texto }}</a>
          </div>
          <div class="guarantee" data-reveal style="--d:.35s">
            <div class="seal">{{ c.entradas.bloque.sello | md }}</div>
            <p class="muted">{{ c.entradas.bloque.texto | md }}</p>
          </div>
        </div>
        <div class="faq" data-reveal style="--d:.15s">
          <details open>
            <summary>{{ c.entradas.bloque_2.texto | texto }}</summary>
            <div>{{ c.entradas.bloque_2.texto_2 | md }}</div>
          </details>
          <details>
            <summary>{{ c.entradas.bloque_3.texto | texto }}</summary>
            <div>{{ c.entradas.bloque_3.texto_2 | md }}</div>
          </details>
          <details>
            <summary>{{ c.entradas.bloque_4.texto | texto }}</summary>
            <div>{{ c.entradas.bloque_4.texto_2 | md }}</div>
          </details>
          <details>
            <summary>{{ c.entradas.bloque_5.texto | texto }}</summary>
            <div>{{ c.entradas.bloque_5.texto_2 | md }}</div>
          </details>
          <details>
            <summary>{{ c.entradas.bloque_6.texto | texto }}</summary>
            <div>{{ c.entradas.bloque_6.texto_2 | md }}</div>
          </details>
        </div>
      </div>
      <p class="center dim mt-4" style="font-size:.85rem; letter-spacing:.2em; text-transform:uppercase">{{ c.entradas.texto | md }}</p>
    </div>
  </section>
</main>

<div class="sticky-cta">
  <a class="btn btn-blood btn-sm" {{ ajustes.entradas.cedp | enlace }}>{{ c.barra_reserva.boton | texto }}</a>
</div>
{% endblock %}
