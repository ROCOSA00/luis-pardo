---
permalink: /admin/index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Panel de Luis Pardo</title>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/css/fuentes.css">
<style id="estilo-acceso">
  :root {
    --bg: #07060a; --ink: #ece4d6; --muted: #b3a998; --dim: #8a8073;
    --gold: #c9a45a; --gold-2: #ecd59a; --blood: #c4162f; --blood-2: #8a0d20;
    --line: rgba(201, 164, 90, 0.25);
  }
  #acceso, #acceso * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body.acceso-activo {
    min-height: 100vh; display: grid; place-items: center; padding: 24px 16px;
    background: radial-gradient(ellipse at 50% 20%, rgba(196, 22, 47, 0.16), transparent 60%), var(--bg);
    color: var(--ink); font: 16px/1.5 Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  #acceso .tarjeta {
    width: 100%; max-width: 400px; padding: 40px 32px 32px; text-align: center;
    background: rgba(255, 255, 255, 0.035); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }
  #acceso .sello { width: 64px; height: 64px; color: var(--gold); margin: 0 auto 14px; display: block; }
  #acceso h1 { font: 600 28px/1.1 Cinzel, Georgia, serif; letter-spacing: 0.06em; margin: 0; }
  #acceso .sub { color: var(--gold-2); font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; margin: 8px 0 28px; }
  #acceso form { display: grid; gap: 16px; text-align: left; }
  #acceso label { display: grid; gap: 6px; font-size: 14px; color: var(--muted); }
  #acceso input[type="email"], #acceso input[type="password"], #acceso input[type="text"] {
    width: 100%; padding: 13px 14px; font: inherit; color: var(--ink);
    background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(236, 228, 214, 0.14); border-radius: 10px;
  }
  #acceso input:focus { outline: 2px solid var(--gold); outline-offset: 1px; border-color: transparent; }
  #acceso .ver { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--dim); cursor: pointer; }
  #acceso .ver input { accent-color: var(--gold); width: 16px; height: 16px; }
  #acceso button {
    margin-top: 6px; padding: 14px; font: 600 15px Inter, sans-serif; letter-spacing: 0.04em; color: #fff; cursor: pointer;
    background: linear-gradient(180deg, var(--blood), var(--blood-2)); border: 0; border-radius: 999px;
  }
  #acceso button:hover { filter: brightness(1.12); }
  #acceso button:disabled { opacity: 0.6; cursor: wait; }
  #acceso .mensaje { margin: 0 0 16px; padding: 10px 12px; font-size: 14px; border-radius: 10px; text-align: center; }
  #acceso .mensaje.error { color: #ffd6d6; background: rgba(196, 22, 47, 0.18); border: 1px solid rgba(196, 22, 47, 0.45); }
  #acceso .mensaje.info { color: var(--gold-2); background: rgba(201, 164, 90, 0.1); border: 1px solid var(--line); }
  #acceso .ayuda { margin: 22px 0 0; font-size: 13px; color: var(--dim); }
  #acceso .ayuda a { color: var(--gold); }
  #acceso .estado { color: var(--muted); font-size: 15px; letter-spacing: 0.04em; }
  #acceso .estado::before {
    content: ""; display: block; width: 34px; height: 34px; margin: 0 auto 14px; border-radius: 50%;
    border: 2px solid var(--line); border-top-color: var(--gold); animation: girar 0.9s linear infinite;
  }
  @keyframes girar { to { transform: rotate(360deg); } }
  #acceso h2 { font: 600 18px/1.3 Cinzel, Georgia, serif; letter-spacing: 0.04em; margin: 0; color: var(--gold-2); text-align: center; }
  #acceso .texto { margin: 0; font-size: 14px; color: var(--muted); text-align: center; }
  #acceso .pista { margin: -6px 0 0; font-size: 13px; color: var(--dim); }
  #acceso .enlaces { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 18px; margin: 2px 0 0; }
  #acceso button.enlace {
    margin: 0; padding: 4px 2px; font: 400 14px/1.4 Inter, sans-serif; letter-spacing: 0; color: var(--gold); cursor: pointer;
    background: none; border: 0; border-radius: 4px; text-decoration: underline; text-underline-offset: 3px;
  }
  #acceso button.enlace:hover { filter: none; color: var(--gold-2); }
  #acceso button:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  #acceso [hidden] { display: none !important; }
</style>
</head>
<body class="acceso-activo">
<main id="acceso">
  <p class="estado" id="estado">Abriendo el panel…</p>

  <div class="tarjeta" id="tarjeta" hidden>
    <svg class="sello" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="32" cy="32" r="30"/>
      <circle cx="32" cy="32" r="25" stroke-dasharray="2 4"/>
      <path d="M32 9 L53 45 H11 Z"/>
      <path d="M18 34 C 24 26, 40 26, 46 34 C 40 42, 24 42, 18 34 Z"/>
      <circle cx="32" cy="34" r="4.5" fill="currentColor"/>
    </svg>
    <h1>Luis Pardo</h1>
    <p class="sub">Panel de edición</p>

    <p class="mensaje" id="mensaje" role="alert" hidden></p>

    <form id="v-entrar" novalidate>
      <label>Email
        <input type="email" name="email" autocomplete="username" required>
      </label>
      <label>Contraseña
        <input type="password" name="password" data-clave autocomplete="current-password" required>
      </label>
      <label class="ver"><input type="checkbox"> Mostrar la contraseña</label>
      <button type="submit">Entrar</button>
      <p class="enlaces">
        <button type="button" class="enlace" data-ir="olvido">He olvidado mi contraseña</button>
        <button type="button" class="enlace" data-ir="cambiar">Cambiar la contraseña</button>
      </p>
    </form>

    <form id="v-cambiar" novalidate hidden>
      <h2>Cambiar la contraseña</h2>
      <label>Email
        <input type="email" name="email" autocomplete="username" required>
      </label>
      <label>Contraseña actual
        <input type="password" name="actual" data-clave autocomplete="current-password" required>
      </label>
      <label>Contraseña nueva
        <input type="password" name="nueva" data-clave autocomplete="new-password" minlength="10" required>
      </label>
      <label>Repite la contraseña nueva
        <input type="password" name="repetir" data-clave autocomplete="new-password" minlength="10" required>
      </label>
      <p class="pista">Mínimo 10 caracteres. Una frase que recuerdes bien sirve, por ejemplo «mi perro come pipas».</p>
      <label class="ver"><input type="checkbox"> Mostrar las contraseñas</label>
      <button type="submit">Guardar y entrar</button>
      <p class="enlaces"><button type="button" class="enlace" data-ir="entrar">Volver</button></p>
    </form>

    <form id="v-olvido" novalidate hidden>
      <h2>¿Has olvidado tu contraseña?</h2>
      <p class="texto">Escribe tu email y te enviamos un enlace para poner una nueva.</p>
      <label>Email
        <input type="email" name="email" autocomplete="username" required>
      </label>
      <button type="submit">Enviarme el enlace</button>
      <p class="enlaces"><button type="button" class="enlace" data-ir="entrar">Volver</button></p>
    </form>

    <form id="v-restablecer" novalidate hidden>
      <h2>Pon una contraseña nueva</h2>
      <label>Contraseña nueva
        <input type="password" name="nueva" data-clave autocomplete="new-password" minlength="10" required>
      </label>
      <label>Repite la contraseña nueva
        <input type="password" name="repetir" data-clave autocomplete="new-password" minlength="10" required>
      </label>
      <p class="pista">Mínimo 10 caracteres. Una frase que recuerdes bien sirve, por ejemplo «mi perro come pipas».</p>
      <label class="ver"><input type="checkbox"> Mostrar las contraseñas</label>
      <button type="submit">Guardar y entrar</button>
    </form>

    <p class="ayuda">Desde aquí puedes cambiar los textos, las fotos y los enlaces de la web.<br><a href="/admin/guia/">¿Primera vez? Mira la guía</a> · <a href="/">Volver a la web</a></p>
  </div>
</main>

<script>
(() => {
  const USUARIO = "sveltia-cms.user";
  const PREFERENCIAS = "sveltia-cms.prefs";
  const VISTAS = ["entrar", "cambiar", "olvido", "restablecer"];
  const SIN_CONEXION = "No hay conexión. Revisa internet y vuelve a intentarlo.";
  const MINIMO = 10;
  const $ = (id) => document.getElementById(id);
  let vistaActual = "entrar";
  let codigoRestablecer = "";

  const mostrarEstado = (texto) => {
    $("tarjeta").hidden = true;
    $("estado").hidden = false;
    $("estado").textContent = texto;
  };

  const aviso = (texto, tipo = "error") => {
    const m = $("mensaje");
    m.hidden = !texto;
    m.textContent = texto || "";
    m.className = "mensaje " + tipo;
    // Vuelve a activar el botón del formulario que estaba enviando.
    document.querySelectorAll("#acceso button[type=submit]").forEach((b) => {
      b.disabled = false;
      if (b.dataset.texto) b.textContent = b.dataset.texto;
    });
  };

  // Muestra una de las pantallas: entrar, cambiar, olvido o restablecer.
  const mostrarVista = (nombre, texto, tipo = "error") => {
    vistaActual = nombre;
    $("estado").hidden = true;
    $("tarjeta").hidden = false;
    for (const v of VISTAS) $("v-" + v).hidden = v !== nombre;
    aviso(texto, tipo);
    if (!texto || tipo === "info") $("v-" + nombre).querySelector("input:not([type=checkbox])")?.focus();
  };
  const mostrarAcceso = (texto, tipo) => mostrarVista("entrar", texto, tipo);

  const ocupado = (formulario, texto) => {
    const b = formulario.querySelector("button[type=submit]");
    b.dataset.texto ||= b.textContent;
    b.disabled = true;
    b.textContent = texto;
  };

  const guardar = (clave, valor) => {
    try { localStorage.setItem(clave, JSON.stringify(valor)); } catch {}
  };
  const leer = (clave) => {
    try { return JSON.parse(localStorage.getItem(clave) || "null"); } catch { return null; }
  };
  const olvidar = () => {
    try { localStorage.removeItem(USUARIO); } catch {}
  };

  // Llama al servidor; si responde con error, lanza su mensaje.
  async function llamar(url, cuerpo) {
    const r = await fetch(url, {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(cuerpo),
    }).catch(() => {
      throw new Error(SIN_CONEXION);
    });
    const json = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(json.error || "No se ha podido completar. Inténtalo de nuevo.");
    return json;
  }

  // Pide el permiso de edición (y el email de acceso) al servidor, solo si la
  // sesión está abierta.
  async function pedirToken() {
    const r = await fetch("/api/sesion/", { credentials: "same-origin", cache: "no-store" }).catch(() => {
      throw new Error(SIN_CONEXION);
    });
    if (r.status === 503) {
      const { error } = await r.json().catch(() => ({}));
      throw new Error(error || "El panel todavía no está configurado.");
    }
    if (!r.ok) return null;
    return r.json();
  }

  // El editor muestra la cuenta de GitHub dueña del token (nombre, foto y
  // enlace a su perfil). En su lugar se muestra el email de acceso, el emblema
  // de la web y, al pulsar sobre la cuenta, la guía del panel.
  function ocultarCuentaGitHub(email) {
    const fetchOriginal = window.fetch.bind(window);
    window.fetch = async (recurso, opciones) => {
      const respuesta = await fetchOriginal(recurso, opciones);
      const url = typeof recurso === "string" ? recurso : recurso?.url || String(recurso);
      if (!/^https:\/\/api\.github\.com\/user\/?(\?|$)/.test(url) || !respuesta.ok) return respuesta;
      try {
        const perfil = await respuesta.clone().json();
        const cuenta = email || "Luis Pardo";
        Object.assign(perfil, {
          login: cuenta,
          name: cuenta,
          avatar_url: new URL("/assets/img/favicon.svg", location.href).href,
          html_url: new URL("/admin/guia/", location.href).href,
        });
        return new Response(JSON.stringify(perfil), { status: 200, headers: { "Content-Type": "application/json" } });
      } catch {
        return respuesta;
      }
    };
  }

  async function abrirEditor({ token, email, repositorio, rama }, texto = "Abriendo el panel…") {
    mostrarEstado(texto);
    // Comprobar que el permiso sigue funcionando antes de abrir el editor.
    const prueba = await fetch(`https://api.github.com/repos/${repositorio}`, {
      headers: { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json" },
    }).catch(() => null);
    if (!prueba || !prueba.ok) {
      olvidar();
      const motivo = prueba
        ? "El permiso para guardar cambios ha caducado o se ha retirado. Avisa a quien te hizo la web."
        : SIN_CONEXION;
      mostrarAcceso(motivo);
      return;
    }
    // El editor (Sveltia CMS) entra solo con este permiso y en español.
    guardar(USUARIO, { backendName: "github", token });
    ocultarCuentaGitHub(email);
    const prefs = leer(PREFERENCIAS) || {};
    if (!prefs.locale || prefs.locale === "auto") guardar(PREFERENCIAS, { ...prefs, locale: "es-CO" });

    document.body.classList.remove("acceso-activo");
    $("acceso").remove();
    $("estilo-acceso").remove();
    // El repositorio no está en config.yml (no se publica): se le pasa al editor aquí.
    window.CMS_MANUAL_INIT = true;
    const s = document.createElement("script");
    s.src = "./sveltia-cms.js";
    s.onload = () => window.CMS.init({ config: { backend: { name: "github", repo: repositorio, branch: rama } } });
    document.body.append(s);
  }

  // Con la sesión ya abierta por el servidor, entra en el editor.
  async function entrarAlEditor(texto) {
    const sesion = await pedirToken();
    if (!sesion?.token) throw new Error("Tu navegador no ha guardado la sesión. Activa las cookies e inténtalo de nuevo.");
    await abrirEditor(sesion, texto);
  }

  // Comprueba la contraseña nueva antes de enviarla.
  function problemaConLaNueva({ nueva, repetir, actual }) {
    if (!nueva || nueva.length < MINIMO) return `La contraseña nueva debe tener al menos ${MINIMO} caracteres.`;
    if (nueva !== repetir) return "Las dos contraseñas nuevas no son iguales. Escríbelas otra vez.";
    if (actual !== undefined && nueva === actual) return "La contraseña nueva tiene que ser distinta de la actual.";
    return null;
  }

  // Enlaces entre pantallas y «Mostrar la contraseña».
  document.querySelectorAll("[data-ir]").forEach((b) =>
    b.addEventListener("click", () => {
      const email = $("v-" + vistaActual).querySelector("input[name=email]")?.value;
      const destino = $("v-" + b.dataset.ir).querySelector("input[name=email]");
      if (email && destino && !destino.value) destino.value = email;
      mostrarVista(b.dataset.ir);
    })
  );
  document.querySelectorAll(".ver input").forEach((casilla) =>
    casilla.addEventListener("change", () => {
      casilla.closest("form").querySelectorAll("[data-clave]").forEach((i) => (i.type = casilla.checked ? "text" : "password"));
    })
  );

  const al = (vista, accion) =>
    $("v-" + vista).addEventListener("submit", async (e) => {
      e.preventDefault();
      const formulario = e.target;
      const datos = Object.fromEntries(new FormData(formulario));
      try {
        await accion(datos, formulario);
      } catch (err) {
        if ($("acceso")) mostrarVista(vista, err.message || SIN_CONEXION);
      }
    });

  al("entrar", async ({ email, password }, f) => {
    if (!email || !password) return aviso("Escribe tu email y tu contraseña.");
    ocupado(f, "Entrando…");
    await llamar("/api/login/", { email, password });
    await entrarAlEditor();
  });

  al("cambiar", async ({ email, actual, nueva, repetir }, f) => {
    if (!email || !actual) return aviso("Escribe tu email y tu contraseña actual.");
    const problema = problemaConLaNueva({ nueva, repetir, actual });
    if (problema) return aviso(problema);
    ocupado(f, "Guardando…");
    await llamar("/api/clave/", { email, actual, nueva });
    f.reset();
    await entrarAlEditor("Contraseña cambiada. Abriendo el panel…");
  });

  al("olvido", async ({ email }, f) => {
    if (!email) return aviso("Escribe tu email.");
    ocupado(f, "Enviando…");
    const { modo } = await llamar("/api/olvido/", { email });
    if (modo === "manual") {
      return aviso("La recuperación por email no está activada en esta web. Pide ayuda a quien te la configuró.");
    }
    $("v-entrar").querySelector("input[name=password]").value = "";
    mostrarAcceso(
      "Si el email es el correcto, te acabamos de enviar un enlace para poner una contraseña nueva. Mira tu correo (y la carpeta de spam). El enlace vale durante una hora.",
      "info"
    );
  });

  al("restablecer", async ({ nueva, repetir }, f) => {
    const problema = problemaConLaNueva({ nueva, repetir });
    if (problema) return aviso(problema);
    ocupado(f, "Guardando…");
    await llamar("/api/restablecer/", { codigo: codigoRestablecer, nueva });
    f.reset();
    await entrarAlEditor("Contraseña guardada. Abriendo el panel…");
  });

  // Al cargar.
  (async () => {
    const parametros = new URLSearchParams(location.search);
    // Enlace del email «He olvidado mi contraseña».
    if (parametros.has("restablecer")) {
      codigoRestablecer = parametros.get("restablecer") || "";
      history.replaceState(null, "", location.pathname);
      return mostrarVista("restablecer");
    }
    // Enlace «Cambiar mi contraseña» de la guía.
    if (parametros.has("contrasena")) {
      history.replaceState(null, "", location.pathname);
      return mostrarVista("cambiar");
    }
    if (parametros.has("salir")) {
      olvidar();
      history.replaceState(null, "", location.pathname);
      return mostrarAcceso("Has cerrado la sesión. ¡Hasta pronto!", "info");
    }
    // Si la sesión sigue abierta, directo al editor.
    try {
      const sesion = await pedirToken();
      if (sesion?.token) return abrirEditor(sesion);
      olvidar();
      mostrarAcceso();
    } catch (err) {
      mostrarAcceso(err.message);
    }
  })();
})();
</script>
</body>
</html>
