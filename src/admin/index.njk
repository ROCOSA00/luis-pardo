---
permalink: /admin/index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Panel de Luis Pardo</title>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style id="estilo-acceso">
  :root {
    --bg: #07060a; --ink: #ece4d6; --muted: #b3a998; --dim: #7a7064;
    --gold: #c9a45a; --gold-2: #ecd59a; --blood: #c4162f; --blood-2: #8a0d20;
    --line: rgba(201, 164, 90, 0.25);
  }
  #acceso, #acceso * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body.acceso-activo {
    min-height: 100vh; display: grid; place-items: center; padding: 24px 16px;
    background: radial-gradient(ellipse at 50% 20%, rgba(196, 22, 47, 0.16), transparent 60%), var(--bg);
    color: var(--ink); font: 16px/1.5 Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  #acceso .tarjeta {
    width: 100%; max-width: 400px; padding: 40px 32px 32px; text-align: center;
    background: rgba(255, 255, 255, 0.035); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }
  #acceso .sello { width: 64px; height: 64px; color: var(--gold); margin: 0 auto 14px; display: block; }
  #acceso h1 { font: 600 28px/1.1 Cinzel, Georgia, serif; letter-spacing: 0.06em; margin: 0; }
  #acceso .sub { color: var(--gold-2); font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; margin: 8px 0 28px; }
  #acceso form { display: grid; gap: 16px; text-align: left; }
  #acceso label { display: grid; gap: 6px; font-size: 14px; color: var(--muted); }
  #acceso input[type="email"], #acceso input[type="password"], #acceso input[type="text"] {
    width: 100%; padding: 13px 14px; font: inherit; color: var(--ink);
    background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(236, 228, 214, 0.14); border-radius: 10px;
  }
  #acceso input:focus { outline: 2px solid var(--gold); outline-offset: 1px; border-color: transparent; }
  #acceso .ver { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--dim); cursor: pointer; }
  #acceso .ver input { accent-color: var(--gold); width: 16px; height: 16px; }
  #acceso button {
    margin-top: 6px; padding: 14px; font: 600 15px Inter, sans-serif; letter-spacing: 0.04em; color: #fff; cursor: pointer;
    background: linear-gradient(180deg, var(--blood), var(--blood-2)); border: 0; border-radius: 999px;
  }
  #acceso button:hover { filter: brightness(1.12); }
  #acceso button:disabled { opacity: 0.6; cursor: wait; }
  #acceso .mensaje { margin: 0; padding: 10px 12px; font-size: 14px; border-radius: 10px; text-align: center; }
  #acceso .mensaje.error { color: #ffd6d6; background: rgba(196, 22, 47, 0.18); border: 1px solid rgba(196, 22, 47, 0.45); }
  #acceso .mensaje.info { color: var(--gold-2); background: rgba(201, 164, 90, 0.1); border: 1px solid var(--line); }
  #acceso .ayuda { margin: 22px 0 0; font-size: 13px; color: var(--dim); }
  #acceso .ayuda a { color: var(--gold); }
  #acceso .estado { color: var(--muted); font-size: 15px; letter-spacing: 0.04em; }
  #acceso .estado::before {
    content: ""; display: block; width: 34px; height: 34px; margin: 0 auto 14px; border-radius: 50%;
    border: 2px solid var(--line); border-top-color: var(--gold); animation: girar 0.9s linear infinite;
  }
  @keyframes girar { to { transform: rotate(360deg); } }
  #acceso [hidden] { display: none !important; }
</style>
</head>
<body class="acceso-activo">
<main id="acceso">
  <p class="estado" id="estado">Abriendo el panel…</p>

  <div class="tarjeta" id="tarjeta" hidden>
    <svg class="sello" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="32" cy="32" r="30"/>
      <circle cx="32" cy="32" r="25" stroke-dasharray="2 4"/>
      <path d="M32 9 L53 45 H11 Z"/>
      <path d="M18 34 C 24 26, 40 26, 46 34 C 40 42, 24 42, 18 34 Z"/>
      <circle cx="32" cy="34" r="4.5" fill="currentColor"/>
    </svg>
    <h1>Luis Pardo</h1>
    <p class="sub">Panel de edición</p>

    <form id="formulario" novalidate>
      <p class="mensaje" id="mensaje" role="alert" hidden></p>
      <label>Email
        <input type="email" name="email" autocomplete="username" required>
      </label>
      <label>Contraseña
        <input type="password" name="password" id="password" autocomplete="current-password" required>
      </label>
      <label class="ver"><input type="checkbox" id="ver"> Mostrar la contraseña</label>
      <button type="submit" id="entrar">Entrar</button>
    </form>

    <p class="ayuda">Desde aquí puedes cambiar los textos, las fotos y los enlaces de la web.<br><a href="/">Volver a la web</a></p>
  </div>
</main>

<script>
(() => {
  const REPOSITORIO = "{{ sitio.repositorio }}";
  const USUARIO = "sveltia-cms.user";
  const PREFERENCIAS = "sveltia-cms.prefs";
  const $ = (id) => document.getElementById(id);

  const mostrarEstado = (texto) => {
    $("tarjeta").hidden = true;
    $("estado").hidden = false;
    $("estado").textContent = texto;
  };

  const mostrarAcceso = (texto, tipo = "error") => {
    $("estado").hidden = true;
    $("tarjeta").hidden = false;
    const m = $("mensaje");
    m.hidden = !texto;
    m.textContent = texto || "";
    m.className = "mensaje " + tipo;
    $("entrar").disabled = false;
    $("entrar").textContent = "Entrar";
    if (!texto || tipo === "info") document.querySelector("input[name=email]").focus();
  };

  const guardar = (clave, valor) => {
    try { localStorage.setItem(clave, JSON.stringify(valor)); } catch {}
  };
  const leer = (clave) => {
    try { return JSON.parse(localStorage.getItem(clave) || "null"); } catch { return null; }
  };
  const olvidar = () => {
    try { localStorage.removeItem(USUARIO); } catch {}
  };

  // Pide el permiso de edición al servidor (solo si la sesión está abierta).
  async function pedirToken() {
    const r = await fetch("/api/sesion/", { credentials: "same-origin", cache: "no-store" });
    if (r.status === 503) throw new Error("El panel todavía no está configurado. Avisa a quien te hizo la web.");
    if (!r.ok) return null;
    return (await r.json()).token;
  }

  async function abrirEditor(token) {
    mostrarEstado("Abriendo el panel…");
    // Comprobar que el permiso sigue funcionando antes de abrir el editor.
    const prueba = await fetch(`https://api.github.com/repos/${REPOSITORIO}`, {
      headers: { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json" },
    }).catch(() => null);
    if (!prueba || !prueba.ok) {
      olvidar();
      const motivo = prueba
        ? "El permiso para guardar cambios ha caducado o se ha retirado. Avisa a quien te hizo la web."
        : "No hay conexión. Revisa internet y vuelve a intentarlo.";
      mostrarAcceso(motivo);
      return;
    }
    // El editor (Sveltia CMS) entra solo con este permiso y en español.
    guardar(USUARIO, { backendName: "github", token });
    const prefs = leer(PREFERENCIAS) || {};
    if (!prefs.locale || prefs.locale === "auto") guardar(PREFERENCIAS, { ...prefs, locale: "es-CO" });

    document.body.classList.remove("acceso-activo");
    $("acceso").remove();
    $("estilo-acceso").remove();
    const s = document.createElement("script");
    s.src = "./sveltia-cms.js";
    document.body.append(s);
  }

  $("ver").addEventListener("change", (e) => {
    $("password").type = e.target.checked ? "text" : "password";
  });

  $("formulario").addEventListener("submit", async (e) => {
    e.preventDefault();
    const datos = Object.fromEntries(new FormData(e.target));
    if (!datos.email || !datos.password) return mostrarAcceso("Escribe tu email y tu contraseña.");
    $("entrar").disabled = true;
    $("entrar").textContent = "Entrando…";
    try {
      const r = await fetch("/api/login/", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: datos.email, password: datos.password }),
      });
      if (!r.ok) {
        const { error } = await r.json().catch(() => ({}));
        return mostrarAcceso(error || "No se ha podido entrar. Inténtalo de nuevo.");
      }
      const token = await pedirToken();
      if (!token) return mostrarAcceso("Tu navegador no ha guardado la sesión. Activa las cookies e inténtalo de nuevo.");
      await abrirEditor(token);
    } catch (err) {
      mostrarAcceso(err.message || "No hay conexión. Revisa internet y vuelve a intentarlo.");
    }
  });

  // Al cargar: si la sesión sigue abierta, directo al editor.
  (async () => {
    if (location.search.includes("salir")) {
      olvidar();
      history.replaceState(null, "", location.pathname);
      return mostrarAcceso("Has cerrado la sesión. ¡Hasta pronto!", "info");
    }
    try {
      const token = await pedirToken();
      if (token) return abrirEditor(token);
      olvidar();
      mostrarAcceso();
    } catch (err) {
      mostrarAcceso(err.message);
    }
  })();
})();
</script>
</body>
</html>
