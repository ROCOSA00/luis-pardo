<title>Cómo editar tu web · Panel de Luis Pardo</title>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #07060a; --bg-2: #0d0a11; --ink: #ece4d6; --muted: #b3a998; --dim: #7a7064;
    --gold: #c9a45a; --gold-2: #ecd59a; --blood: #c4162f; --line: rgba(201, 164, 90, 0.22);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: radial-gradient(ellipse at 50% 0%, rgba(196, 22, 47, 0.14), transparent 55%), var(--bg);
    color: var(--ink); font: 17px/1.65 Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 860px; margin: 0 auto; padding: 48px 16px 80px; }
  header { text-align: center; margin-bottom: 40px; }
  .sello { width: 56px; height: 56px; color: var(--gold); }
  h1 { font: 600 clamp(28px, 5vw, 40px)/1.15 Cinzel, Georgia, serif; letter-spacing: 0.04em; margin: 12px 0 8px; }
  .sub { color: var(--muted); margin: 0; }
  .boton {
    display: inline-block; margin-top: 22px; padding: 12px 28px; border-radius: 999px; color: #fff; font-weight: 600;
    text-decoration: none; background: linear-gradient(180deg, var(--blood), #8a0d20);
  }
  ol.pasos { list-style: none; counter-reset: paso; padding: 0; margin: 0; display: grid; gap: 28px; }
  ol.pasos > li {
    counter-increment: paso; position: relative; padding: 28px 24px 24px;
    background: rgba(255, 255, 255, 0.03); border: 1px solid var(--line); border-radius: 18px;
  }
  ol.pasos > li::before {
    content: counter(paso); position: absolute; top: -16px; left: 24px; width: 34px; height: 34px; border-radius: 50%;
    display: grid; place-items: center; font: 600 16px Cinzel, serif; color: var(--bg); background: var(--gold);
  }
  h2 { font: 600 21px/1.3 Cinzel, Georgia, serif; letter-spacing: 0.03em; margin: 0 0 8px; color: var(--gold-2); }
  p { margin: 0 0 12px; }
  ul { margin: 0 0 12px; padding-left: 20px; }
  li li { margin-bottom: 6px; }
  strong { color: #fff; font-weight: 600; }
  figure { margin: 16px 0 0; }
  figure img { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid rgba(236, 228, 214, 0.12); }
  figure.pequena img { max-width: 420px; }
  .nota { margin-top: 32px; padding: 22px 24px; border-radius: 16px; border: 1px solid var(--line); background: rgba(201, 164, 90, 0.07); }
  .nota h2 { font-size: 18px; }
  .nota p:last-child { margin-bottom: 0; }
  a { color: var(--gold); }
  kbd { font: 600 14px Inter, sans-serif; padding: 1px 7px; border-radius: 6px; border: 1px solid rgba(236, 228, 214, 0.25); background: rgba(255, 255, 255, 0.06); }
  footer { margin-top: 40px; text-align: center; color: var(--dim); font-size: 14px; }
</style>
