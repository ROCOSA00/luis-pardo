                  - { name: texto, label: Texto, widget: string }
                  - { name: enlace, label: Dirección (a dónde lleva), widget: string, hint: "Página de esta web: escribe la ruta, por ejemplo /curso/. Otra web: la dirección completa (https://…)." }
