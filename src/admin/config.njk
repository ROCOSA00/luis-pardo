---
permalink: /admin/config.yml
eleventyExcludeFromCollections: true
---
# Configuración del panel de edición (Sveltia CMS): https://sveltiacms.app/en/docs
#
# Cada página de la web es un archivo de src/_data/paginas/ y aquí se define
# el formulario con el que se edita. Si cambias una plantilla y añades un
# texto nuevo, añade aquí su campo con el mismo nombre que en el JSON.
backend:
  name: github
  repo: {{ sitio.repositorio }}
  branch: {{ sitio.rama }}
  auth_methods: [token]
  commit_messages:
    create: "Panel: crear {{ '{{' }}collection{{ '}}' }} «{{ '{{' }}slug{{ '}}' }}»"
    update: "Panel: editar {{ '{{' }}collection{{ '}}' }} «{{ '{{' }}slug{{ '}}' }}»"
    delete: "Panel: borrar {{ '{{' }}collection{{ '}}' }} «{{ '{{' }}slug{{ '}}' }}»"
    uploadMedia: "Panel: subir {{ '{{' }}path{{ '}}' }}"
    deleteMedia: "Panel: borrar {{ '{{' }}path{{ '}}' }}"
{% raw %}app_title: Panel de Luis Pardo
logo: { src: "/assets/img/favicon.svg" }
media_folder: assets/img
public_folder: "/assets/img"
media_libraries:
  default:
    config:
      max_file_size: 26214400
      slugify_filename: true
      transformations:
        raster_image: { format: webp, quality: 82, width: 1600, height: 1600 }
logout_redirect_url: "/api/salir/"
editor: { preview: false }
field_defaults:
  richtext:
    minimal: true
    modes: [rich_text]
    buttons: [bold, italic, link]
    editor_components: []
collections:
  - name: principal
    label: Principal
    icon: home
    description: "La portada, la página de entradas y los datos de contacto que se usan en toda la web."
    files:
      - name: inicio
        label: Inicio
        file: src/_data/paginas/inicio.json
        preview_path: "/"
        fields:
          - name: seo
            label: Google y redes sociales
            widget: object
            collapsed: true
            fields:
              - { name: titulo, label: Título en Google, widget: string, hint: Lo que sale en la pestaña del navegador y como título en Google. }
              - { name: descripcion, label: Descripción en Google, widget: text, hint: Unas 25 palabras. Es el texto que aparece debajo del título en Google. }
              - { name: titulo_redes, label: Título al compartir en redes, widget: string, required: false }
              - { name: descripcion_redes, label: Descripción al compartir en redes, widget: text, required: false }
              - { name: imagen_redes, label: Imagen al compartir en redes, widget: image, required: false, hint: "La foto que aparece al compartir la página en WhatsApp, Facebook…" }
          - name: cabecera
            label: 1 · Cabecera
            widget: object
            collapsed: true
            fields:
              - { name: imagen, label: Imagen, widget: image }
              - { name: antetitulo, label: Antetítulo, widget: string }
              - { name: titulo, label: Título principal, widget: markdown, buttons: [italic], hint: Lo que pongas en cursiva se verá resaltado en color. }
              - { name: texto, label: Texto, widget: markdown }
              - name: entradilla
                label: Entradilla
                widget: object
                fields:
                  - { name: antes, label: Texto antes de la palabra que cambia, widget: markdown, required: false }
                  - name: palabras
                    label: Palabras que van cambiando
                    widget: list
                    field: { name: palabra, label: Palabra, widget: string }
                    hint: Se muestran una tras otra con un efecto de descifrado.
                  - { name: despues, label: Texto después de la palabra que cambia, widget: markdown, required: false }
              - { name: etiqueta, label: Etiqueta, widget: markdown }
              - { name: etiqueta_2, label: Etiqueta 2, widget: markdown }
              - { name: etiqueta_3, label: Etiqueta 3, widget: markdown }
              - { name: boton, label: Botón, widget: string, hint: El enlace de compra se cambia en «Ajustes generales». }
              - name: boton_2
                label: Botón 2
                widget: object
