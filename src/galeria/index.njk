{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><a href="../el-mentalista/">Luis Pardo</a><span aria-hidden="true">/</span><span>Galería</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="masonry" data-lightbox>{% for f in c.seccion_2.fotos %}<a href="{{ f.imagen | ruta }}">{% miniatura f.imagen, f.descripcion or ("Luis Pardo · fotografía " + loop.index + " de la galería") %}</a>{% endfor %}</div>
    </div>
  </section>

  <section class="section cta-final bg-2">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <h2 class="h2" data-reveal>{{ c.las_fotos_cuentan.titulo | titulo }}</h2>
      <div class="row center" data-reveal style="--d:.1s">
        <a class="btn btn-blood btn-lg" {{ c.las_fotos_cuentan.boton.enlace | enlace }}>{{ c.las_fotos_cuentan.boton.texto | texto }}</a>
        <a class="btn btn-ghost btn-lg" {{ c.las_fotos_cuentan.boton_2.enlace | enlace }}>{{ c.las_fotos_cuentan.boton_2.texto | texto }}</a>
      </div>
    </div>
  </section>
</main>
{% endblock %}
