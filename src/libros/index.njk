{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><a href="../el-mentalista/">Luis Pardo</a><span aria-hidden="true">/</span><span>Libros</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack-lg">
      <article class="book" id="mentalismo-l-mental">
        <div class="book-covers" data-reveal="left">
          <img {{ c.seccion_2.mentalismo_mental.imagen.src | img }} alt="{{ c.seccion_2.mentalismo_mental.imagen.alt | texto }}" loading="lazy">
          <img {{ c.seccion_2.mentalismo_mental.imagen_2.src | img }} alt="{{ c.seccion_2.mentalismo_mental.imagen_2.alt | texto }}" loading="lazy">
        </div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.seccion_2.mentalismo_mental.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.seccion_2.mentalismo_mental.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.seccion_2.mentalismo_mental.entradilla | md }}</p>
          </div>
          <ul class="checklist" data-reveal style="--d:.25s">{% for p in c.seccion_2.mentalismo_mental.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
          <p class="muted" data-reveal style="--d:.3s">{{ c.seccion_2.mentalismo_mental.texto | md }}</p>
          <div class="notice" data-reveal style="--d:.35s">{{ c.seccion_2.mentalismo_mental.aviso | md }}</div>
        </div>
      </article>

      <div class="divider" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2l2.5 7.5H22l-6 4.5 2.3 7.5L12 17l-6.3 4.5L8 14 2 9.5h7.5z"/></svg></div>

      <article class="book" id="poemas-prohibidos">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.seccion_2.poemas_prohibidos.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.seccion_2.poemas_prohibidos.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.seccion_2.poemas_prohibidos.entradilla | md }}</p>
          </div>
          <div class="prose" data-reveal style="--d:.25s">{{ c.seccion_2.poemas_prohibidos.texto | mdBloque }}</div>
          <p class="muted" data-reveal style="--d:.3s">{{ c.seccion_2.poemas_prohibidos.texto_2 | md }}</p>
          <div class="notice" data-reveal style="--d:.35s">{{ c.seccion_2.poemas_prohibidos.aviso | md }}</div>
        </div>
        <div class="book-covers order-first-mobile" data-reveal="right">
          <img {{ c.seccion_2.poemas_prohibidos.imagen.src | img }} alt="{{ c.seccion_2.poemas_prohibidos.imagen.alt | texto }}" loading="lazy">
          <img {{ c.seccion_2.poemas_prohibidos.imagen_2.src | img }} alt="{{ c.seccion_2.poemas_prohibidos.imagen_2.alt | texto }}" loading="lazy">
        </div>
      </article>
    </div>
  </section>

  <section class="section cta-final bg-2">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <h2 class="h2" data-reveal>{{ c.llevatelos_firmados_despues.titulo | titulo }}</h2>
      <div class="row center" data-reveal style="--d:.1s"><a class="btn btn-blood btn-lg" {{ c.llevatelos_firmados_despues.boton.enlace | enlace }}>{{ c.llevatelos_firmados_despues.boton.texto | texto }}</a></div>
    </div>
  </section>
</main>
{% endblock %}
