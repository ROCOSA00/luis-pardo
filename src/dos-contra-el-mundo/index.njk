{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="filter:blur(2px)"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Universo</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="hero-tagline" data-reveal style="--d:.2s">{{ c.cabecera.texto | md }}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="grid-2" style="align-items:start">
        <div class="stack-lg">
          <div class="prose" data-reveal>
            <p class="lead">{{ c.seccion_2.entradilla | md }}</p>
            <p>{{ c.seccion_2.texto | md }}</p>
            <p>{{ c.seccion_2.texto_2 | md }}</p>
          </div>
          <div data-reveal style="--d:.1s">
            <span class="eyebrow">{{ c.seccion_2.antetitulo | texto }}</span>
            <div class="video mt-1" data-video="../assets/media/videoclip-sin-tocarte.mp4">
              <img {{ c.seccion_2.video.portada | img }} alt="" loading="lazy">
              <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.seccion_2.video.titulo | texto }}</span></button>
            </div>
          </div>
        </div>

        <div class="player" data-player data-reveal style="--d:.1s">
          <div class="player-top">
            <div class="player-cover"><img {{ c.seccion_2.imagen.src | img }} alt="{{ c.seccion_2.imagen.alt | texto }}" loading="lazy"></div>
            <div>
              <div class="player-now">Ahora suena</div>
              <div class="player-title">Pulsa play para empezar</div>
              <div class="player-controls">
                <button class="prev" type="button" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg></button>
                <button class="play" type="button" aria-label="Reproducir"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
                <button class="next" type="button" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 5h2v14h-2zM4 5v14l11-7z"/></svg></button>
                <div class="player-progress">
                  <div class="player-bar" role="presentation"><span></span></div>
                  <div class="player-time"><span class="t-cur">0:00</span><span class="t-dur">0:00</span></div>
                </div>
              </div>
              <button class="btn btn-ghost btn-sm mt-2" type="button" data-play-all>Escuchar el disco entero</button>
            </div>
          </div>
          <ol class="player-list">{% for t in c.seccion_2.canciones %}{% set n = loop.index | dosCifras %}{% if t.audio %}<li data-src="{{ t.audio | ruta }}" data-title="{{ n }}. {{ t.titulo | texto }}"><button type="button">{% else %}<li class="is-missing" data-title="{{ n }}. {{ t.titulo | texto }}" title="Audio no disponible"><button type="button" disabled>{% endif %}<span class="n">{{ n }}</span><span class="t">{{ t.titulo | texto }}</span><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span></button></li>{% endfor %}</ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-final">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <span class="eyebrow center" data-reveal>{{ c.pon_banda_sonora.antetitulo | texto }}</span>
      <h2 class="h2" data-reveal style="--d:.1s">{{ c.pon_banda_sonora.titulo | titulo }}</h2>
      <div class="row center" data-reveal style="--d:.2s"><a class="btn btn-blood btn-lg" {{ c.pon_banda_sonora.boton.enlace | enlace }}>{{ c.pon_banda_sonora.boton.texto | texto }}</a></div>
    </div>
  </section>
</main>
{% endblock %}
