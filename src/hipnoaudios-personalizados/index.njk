{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="object-position:right center"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><a href="../curso/">Tu mente</a><span aria-hidden="true">/</span><span>MPM</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
        <div class="row" data-reveal style="--d:.3s">
          <a class="btn btn-gold btn-lg" {{ c.cabecera.boton.enlace | enlace }}>{{ c.cabecera.boton.texto | texto }}</a>
          <a class="btn btn-whatsapp btn-lg" href="{{ c.cabecera.boton_2.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.cabecera.boton_2.texto | texto }}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="grid-2">
        <div data-reveal="left">
          <div class="video" data-video="../assets/media/mpm.mp4">
            <img {{ c.disenado_para_llegar.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.disenado_para_llegar.video.titulo | texto }}</span></button>
          </div>
        </div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.disenado_para_llegar.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.disenado_para_llegar.titulo | titulo }}</h2>
          </div>
          <ul class="checklist" data-reveal style="--d:.2s">{% for p in c.disenado_para_llegar.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.para_cualquier_cosa.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.para_cualquier_cosa.titulo | titulo }}</h2>
      </div>
      <ul class="pill-list" style="justify-content:center" data-reveal>{% for p in c.para_cualquier_cosa.puntos %}<li>{{ p | md }}</li>{% endfor %}</ul>
      <ol class="steps mt-4 wrap-narrow" data-reveal>
        <li><div><h3>{{ c.para_cualquier_cosa.test_50_preguntas.titulo | titulo }}</h3><p>{{ c.para_cualquier_cosa.test_50_preguntas.texto | md }}</p></div></li>
        <li><div><h3>{{ c.para_cualquier_cosa.creacion_desde_cero.titulo | titulo }}</h3><p>{{ c.para_cualquier_cosa.creacion_desde_cero.texto | md }}</p></div></li>
        <li><div><h3>{{ c.para_cualquier_cosa.n21_dias_escucha.titulo | titulo }}</h3><p>{{ c.para_cualquier_cosa.n21_dias_escucha.texto | md }}</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section" id="muestra">
    <div class="wrap-narrow">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.muestra.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.muestra.titulo | titulo }}</h2>
        <p class="lead" data-reveal style="--d:.2s">{{ c.muestra.entradilla | md }}</p>
      </div>
      <div class="card audio-card" data-reveal>
        <img {{ c.muestra.hipnoaudio_muestra.imagen | img }} alt="" loading="lazy">
        <div>
          <h3 class="h3">{{ c.muestra.hipnoaudio_muestra.titulo | titulo }}</h3>
          <p>{{ c.muestra.hipnoaudio_muestra.texto | md }}</p>
          <audio controls preload="none" src="../assets/audio/muestra-mpm.mp3"></audio>
        </div>
      </div>
      <div class="grid-2 mt-3" style="align-items:start">
        <div data-reveal>
          <h3 class="h3 mb-2">{{ c.muestra.titulo_2 | titulo }}</h3>
          <ul class="checklist">{% for p in c.muestra.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
        </div>
        <div class="card" data-reveal style="--d:.1s">
          <h3 class="h3">{{ c.muestra.titulo_3 | titulo }}</h3>
          <form class="form mt-2" data-brevo data-success="¡Listo! Revisa tu bandeja de entrada (y la de spam): te hemos enviado tu HipnoAudio gratuito." method="POST" action="https://446471f7.sibforms.com/serve/MUIFAOd_NhoznXgF-xx5DGELAKGUONoJPEVWGENE395G0puokyVzrpwZjq6n-WaWL-4RxnU_4ea5V5ly7UjGIqLOpS9QhOji9S4aDNYG00kKVdDt_9Dsg5Hup4YLEHKDxC_iqCGo9LleyMm4Vtj_-fdAjofByK1G6HYnKZpYEc3ogBbNeVyqeOtNbZq2pWfPT9Cj_ngITqNhJESS">
            <div class="form-row">
              <div class="field"><label for="m-nombre">Nombre</label><input id="m-nombre" name="NOMBRE" autocomplete="given-name" required></div>
              <div class="field"><label for="m-apellidos">Apellidos</label><input id="m-apellidos" name="APELLIDOS" autocomplete="family-name"></div>
            </div>
            <div class="field"><label for="m-email">Email</label><input id="m-email" type="email" name="EMAIL" autocomplete="email" required></div>
            <label class="check"><input type="checkbox" name="OPT_IN" value="1" required><span>Acepto recibir el audio por email y la <a href="../politica-de-privacidad/">política de privacidad</a>.</span></label>
            <input class="hp" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="hidden" name="locale" value="es">
            <button class="btn btn-gold btn-block" type="submit">Enviarme el audio</button>
            <div class="form-msg" role="status"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-vignette">
    <div class="wrap">
      <div class="grid-2">
        <div class="frame frame-square frame-deco" data-reveal="left"><img {{ c.luis_pardo.imagen.src | img }} alt="{{ c.luis_pardo.imagen.alt | texto }}" loading="lazy"></div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.luis_pardo.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.luis_pardo.titulo | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.luis_pardo.texto | mdBloque }}</div>
          <div class="row" data-reveal style="--d:.3s">
            <a class="btn btn-whatsapp btn-lg" href="{{ c.luis_pardo.boton.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.luis_pardo.boton.texto | texto }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="feature" data-reveal>
        <div class="grid-2">
          <div class="stack">
            <span class="eyebrow">{{ c.seccion_6.antetitulo | texto }}</span>
            <h2 class="h2">{{ c.seccion_6.titulo | titulo }}</h2>
            <p class="lead">{{ c.seccion_6.entradilla | md }}</p>
            <div class="row mt-2"><a class="btn btn-blood" {{ c.seccion_6.boton.enlace | enlace }}>{{ c.seccion_6.boton.texto | texto }}</a></div>
          </div>
          <div class="frame frame-wide"><img {{ c.seccion_6.imagen.src | img }} alt="{{ c.seccion_6.imagen.alt | texto }}" loading="lazy"></div>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
