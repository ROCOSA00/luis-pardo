      <div class="grid-2">
        <div class="frame frame-square frame-deco" data-reveal="left"><img src="../assets/img/luis-retrato.webp" width="1170" height="1169" alt="Luis Pardo" loading="lazy"></div>
        <div class="stack-lg">
