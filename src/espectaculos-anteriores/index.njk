{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><a href="../el-mentalista/">Luis Pardo</a><span aria-hidden="true">/</span><span>Espectáculos</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="stats stats-3" data-reveal>{% for s in c.seccion_2.cifras %}<div class="stat"><span class="stat-num" {{ s.cifra | cifra }}>{{ s.cifra | texto }}</span><span class="stat-label">{{ s.texto | texto }}</span></div>{% endfor %}</div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <p class="center dim mb-2" data-reveal>{{ c.seccion_3.texto | md }}</p>
      <div class="grid-auto">{% for e in c.seccion_3.espectaculos %}<article class="flip" data-reveal{{ retardo(loop.index0, 5, 4) }}><div class="flip-inner"><div class="flip-face flip-front"><img {{ e.imagen.src | img }} alt="{{ e.imagen.alt | texto }}" loading="lazy"><span class="flip-title">{{ e.titulo | texto }}</span></div><div class="flip-face flip-back"><span class="tag">{{ e.etiqueta | texto }}</span><h3>{{ e.titulo | texto }}</h3>{{ e.texto | mdBloque({ enlace: "gold" }) }}</div></div><button class="flip-btn" type="button" aria-label="Girar cartel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></button></article>{% endfor %}</div>
    </div>
  </section>

  <section class="section cta-final">
    <div class="wrap-narrow stack-lg" style="justify-items:center">
      <span class="eyebrow center" data-reveal>{{ c.historia_continua_con.antetitulo | texto }}</span>
      <h2 class="h2" data-reveal style="--d:.1s">{{ c.historia_continua_con.titulo | titulo }}</h2>
      <div class="row center" data-reveal style="--d:.2s"><a class="btn btn-blood btn-lg" {{ c.historia_continua_con.boton.enlace | enlace }}>{{ c.historia_continua_con.boton.texto | texto }}</a></div>
    </div>
  </section>
</main>
{% endblock %}
