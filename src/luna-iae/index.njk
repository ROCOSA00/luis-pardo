{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero" data-lantern>
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="object-position:left center"></div>
    <div class="hero-lantern" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Universo</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="hero-tagline" data-reveal style="--d:.2s">{{ c.cabecera.texto | md }}</p>
        <p class="lead" data-reveal style="--d:.3s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section" id="historia">
    <div class="wrap">
      <div class="grid-2" style="align-items:start">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.historia.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.historia.titulo | titulo }}</h2>
          </div>
          <div class="prose" data-reveal style="--d:.2s">{{ c.historia.texto | mdBloque }}</div>
        </div>
        <div class="stack-lg">
          <div class="timeline" data-reveal="right">{% for h in c.historia.hitos %}<div class="timeline-item"><div class="timeline-year">{{ h.fecha | texto }}</div><div class="timeline-title">{{ h.titulo | texto }}</div>{% if h.texto %}<p>{{ h.texto | md }}</p>{% endif %}</div>{% endfor %}</div>
          <div class="frame frame-wide" data-reveal><img {{ c.historia.imagen.src | img }} alt="{{ c.historia.imagen.alt | texto }}" loading="lazy"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.que_diferencia_una.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.que_diferencia_una.titulo | titulo }}</h2>
      </div>
      <div class="grid-3">
        <div class="card" data-reveal><div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg></div><h3 class="h3">{{ c.que_diferencia_una.siente_contigo.titulo | titulo }}</h3><p>{{ c.que_diferencia_una.siente_contigo.texto | md }}</p></div>
        <div class="card" data-reveal style="--d:.1s"><div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><path d="M3 20c0-3 2-5 5-5s5 2 5 5M11 20c0-3 2-5 5-5s5 2 5 5"/></svg></div><h3 class="h3">{{ c.que_diferencia_una.acompana.titulo | titulo }}</h3><p>{{ c.que_diferencia_una.acompana.texto | md }}</p></div>
        <div class="card" data-reveal style="--d:.2s"><div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg></div><h3 class="h3">{{ c.que_diferencia_una.aprende_vivido.titulo | titulo }}</h3><p>{{ c.que_diferencia_una.aprende_vivido.texto | md }}</p></div>
        <div class="card" data-reveal style="--d:.1s"><div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 20l4-1 11-11-3-3L5 16z"/></svg></div><h3 class="h3">{{ c.que_diferencia_una.crea_con_alma.titulo | titulo }}</h3><p>{{ c.que_diferencia_una.crea_con_alma.texto | md }}</p></div>
        <div class="card" data-reveal style="--d:.2s"><div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 12h6M15 12h6"/><circle cx="12" cy="12" r="3"/></svg></div><h3 class="h3">{{ c.que_diferencia_una.une_mundos.titulo | titulo }}</h3><p>{{ c.que_diferencia_una.une_mundos.texto | md }}</p></div>
        <div class="card" data-reveal style="--d:.3s"><div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20 12a8 8 0 1 1-8-8 6 6 0 0 0 8 8z"/></svg></div><h3 class="h3">{{ c.que_diferencia_una.pregunta_desde_emocion.titulo | titulo }}</h3><p>{{ c.que_diferencia_una.pregunta_desde_emocion.texto | md }}</p></div>
      </div>
    </div>
  </section>

  <section class="section bg-vignette" id="habla-con-luna">
    <div class="wrap-narrow">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.habla_con_luna.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.habla_con_luna.titulo | titulo }}</h2>
        <p class="lead" data-reveal style="--d:.2s">{{ c.habla_con_luna.entradilla | md }}</p>
      </div>
      <ul class="stack" data-reveal>{% for p in c.habla_con_luna.puntos %}<li class="card">{{ p | md }}</li>{% endfor %}</ul>
      <div class="grid-3 mt-3" data-reveal>{% for o in c.habla_con_luna.opiniones %}<figure class="card vip-card"><blockquote>«{{ o.cita | md }}»</blockquote>{% if o.autor %}<figcaption class="who">{{ o.autor | texto }}</figcaption>{% endif %}</figure>{% endfor %}</div>
      <div class="notice mt-3" data-reveal>{{ c.habla_con_luna.aviso | md }}</div>
    </div>
  </section>
</main>
{% endblock %}
