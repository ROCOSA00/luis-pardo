{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero" data-lantern>
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="object-position:right center"></div>
    <div class="hero-lantern" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><span>Tu mente</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
        <div class="row" data-reveal style="--d:.3s">
          <a class="btn btn-whatsapp btn-lg" href="{{ c.cabecera.boton.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.cabecera.boton.texto | texto }}</a>
          <a class="btn btn-ghost btn-lg" {{ c.cabecera.boton_2.enlace | enlace }}>{{ c.cabecera.boton_2.texto | texto }}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.que_vas_entrenar.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.que_vas_entrenar.titulo | titulo }}</h2>
      </div>
      <ul class="pill-list" style="justify-content:center" data-reveal>{% for p in c.que_vas_entrenar.puntos %}<li>{{ p | md }}</li>{% endfor %}</ul>
    </div>
  </section>

  <section class="section bg-2" id="video">
    <div class="wrap">
      <div class="grid-2">
        <div data-reveal="left">
          <div class="video" data-video="../assets/media/alquimia-de-la-mente.mp4">
            <img {{ c.video.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.video.video.titulo | texto }}</span></button>
          </div>
        </div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.video.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.video.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.video.entradilla | md }}</p>
          </div>
          <ul class="checklist" data-reveal style="--d:.25s">{% for p in c.video.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
          <div class="row" data-reveal style="--d:.3s">
            <a class="btn btn-blood" {{ c.video.boton.enlace | enlace }}>{{ c.video.boton.texto | texto }}</a>
            <a class="btn btn-whatsapp" href="{{ c.video.boton_2.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.video.boton_2.texto | texto }}</a>
          </div>
          <p class="form-note" data-reveal style="--d:.35s">{{ c.video.texto | md }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.dos_masterclasses_para.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.dos_masterclasses_para.titulo | titulo }}</h2>
      </div>
      <div class="grid-2" style="align-items:stretch">
        <a class="tarot" {{ c.dos_masterclasses_para.comunicacion_verbal.enlace | enlace }} data-tilt data-reveal>
          <div class="tarot-media" style="aspect-ratio:3/2"><img {{ c.dos_masterclasses_para.comunicacion_verbal.imagen.src | img }} alt="{{ c.dos_masterclasses_para.comunicacion_verbal.imagen.alt | texto }}" loading="lazy"></div>
          <div class="tarot-body"><div class="tarot-meta">{% for d in c.dos_masterclasses_para.comunicacion_verbal.datos %}<span>{{ d | texto }}</span>{% endfor %}</div><h3>{{ c.dos_masterclasses_para.comunicacion_verbal.titulo | titulo }}</h3><p>{{ c.dos_masterclasses_para.comunicacion_verbal.texto | md }}</p></div>
        </a>
        <a class="tarot" {{ c.dos_masterclasses_para.inteligencia_emocional.enlace | enlace }} data-tilt data-reveal style="--d:.1s">
          <div class="tarot-media" style="aspect-ratio:3/2"><img {{ c.dos_masterclasses_para.inteligencia_emocional.imagen.src | img }} alt="{{ c.dos_masterclasses_para.inteligencia_emocional.imagen.alt | texto }}" loading="lazy"></div>
          <div class="tarot-body"><div class="tarot-meta">{% for d in c.dos_masterclasses_para.inteligencia_emocional.datos %}<span>{{ d | texto }}</span>{% endfor %}</div><h3>{{ c.dos_masterclasses_para.inteligencia_emocional.titulo | titulo }}</h3><p>{{ c.dos_masterclasses_para.inteligencia_emocional.texto | md }}</p></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-vignette">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.personas_que_entrenan.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.personas_que_entrenan.titulo | titulo }}</h2>
      </div>
      <div class="carousel" data-carousel data-autoplay="6000" data-reveal>
        <div class="carousel-track">{% for o in c.personas_que_entrenan.opiniones %}<figure class="testimonial"><span class="stars" aria-label="5 estrellas">★★★★★</span><blockquote>{{ o.texto | md }}</blockquote><footer><span class="avatar">{{ o.nombre | inicial }}</span><span><span class="who">{{ o.nombre | texto }}</span>{% if o.detalle %}<br><span class="role">{{ o.detalle | texto }}</span>{% endif %}</span></footer></figure>{% endfor %}</div>
        <div class="carousel-nav">
          <div class="carousel-dots"></div>
          <button class="carousel-btn carousel-prev" type="button" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"/></svg></button>
          <button class="carousel-btn carousel-next" type="button" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="clan-secreto">
    <div class="wrap">
      <div class="grid-2">
        <div class="grid-2" style="gap:16px" data-reveal="left">
          <div class="frame frame-tall"><img {{ c.clan_secreto.imagen.src | img }} alt="{{ c.clan_secreto.imagen.alt | texto }}" loading="lazy"></div>
          <div class="frame frame-tall" style="margin-top:40px"><img {{ c.clan_secreto.imagen_2.src | img }} alt="{{ c.clan_secreto.imagen_2.alt | texto }}" loading="lazy"></div>
        </div>
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.clan_secreto.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.clan_secreto.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.clan_secreto.entradilla | md }}</p>
          </div>
          <ul class="checklist" data-reveal style="--d:.25s">{% for p in c.clan_secreto.puntos %}<li><span>{{ p | md }}</span></li>{% endfor %}</ul>
          <form class="card form" data-brevo data-success="¡Bienvenido al Clan! Te enviaremos por email los pasos a seguir y la contraseña de las Clases Secretas." method="POST" action="https://446471f7.sibforms.com/serve/MUIEADxiKn0H2AZkWZHwx-CK60Yhwp7BkaPH_wdZytbY5T5mj0XA0xcYgBqhzy2ftWi5K0xhCLGaV8ZOzJrwhkQz0suTBt-8OGn-e66R6-AVeL-QTxeknkqKxor216Zg-jWeAY6-SnDk1Hvahv3T5uDwVK_Jv6M3QVB-Ynh2AFEOr8DfJU5q7CQVA4Qn5yD3Uj6_yvg7P6LPI5Y1" data-reveal style="--d:.3s">
            <div class="form-row">
              <div class="field"><label for="c-nombre">Nombre</label><input id="c-nombre" name="NOMBRE" autocomplete="given-name" required></div>
              <div class="field"><label for="c-apellidos">Apellidos</label><input id="c-apellidos" name="APELLIDOS" autocomplete="family-name"></div>
            </div>
            <div class="field"><label for="c-email">Email</label><input id="c-email" type="email" name="EMAIL" autocomplete="email" required></div>
            <label class="check"><input type="checkbox" name="OPT_IN" value="1" required><span>He leído y acepto la <a href="../politica-de-privacidad/">política de privacidad</a>.</span></label>
            <input class="hp" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="hidden" name="locale" value="es">
            <button class="btn btn-gold btn-block" type="submit">Quiero entrar en el Clan</button>
            <div class="form-msg" role="status"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2" id="psiquemagia">
    <div class="wrap">
      <div class="grid-2">
        <div class="stack-lg">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.psiquemagia.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.psiquemagia.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.psiquemagia.entradilla | md }}</p>
          </div>
          <p class="muted" data-reveal style="--d:.25s">{{ c.psiquemagia.texto | md }}</p>
          <form class="card form" data-brevo data-success="¡Gracias! Te escribiremos por WhatsApp para concretar día y hora de la llamada." method="POST" action="https://446471f7.sibforms.com/serve/MUIEAL9IAdShlvJJwmQqROuZSPGfneWZlgylbUOUHgyjBm4uLZDCkaEH3wOi3Gm-v02w8sxvOpFZAQ7KpeZwIaXUQadeXNYuqtj9YUZz7tZ2CYbQhX0Y-FJIo7G0qIf3_FykhM-RQxPb4Jj2EqU4NbIS4UOe88LcGSMVHpcH1uxdbKvg-XgBvqu1_Us1UJXMoOgK2qg5Q4bEcKe8" data-reveal style="--d:.3s">
            <div class="form-row">
              <div class="field"><label for="p-nombre">Nombre</label><input id="p-nombre" name="NOMBRE" autocomplete="given-name" required></div>
              <div class="field"><label for="p-apellidos">Apellidos</label><input id="p-apellidos" name="APELLIDOS" autocomplete="family-name"></div>
            </div>
            <div class="form-row">
              <div class="field"><label for="p-email">Email</label><input id="p-email" type="email" name="EMAIL" autocomplete="email" required></div>
              <div class="field"><label for="p-tel">Teléfono (WhatsApp)</label><input id="p-tel" type="tel" name="TELEFONO" autocomplete="tel" required></div>
            </div>
            <div class="field"><label for="p-fel">¿Qué es para ti la felicidad?</label><textarea id="p-fel" name="FELICIDAD"></textarea></div>
            <label class="check"><input type="checkbox" name="OPT_IN" value="1" required><span>He leído y acepto la <a href="../politica-de-privacidad/">política de privacidad</a>.</span></label>
            <input class="hp" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="hidden" name="locale" value="es">
            <button class="btn btn-blood btn-block" type="submit">Concertar una llamada</button>
            <div class="form-msg" role="status"></div>
          </form>
        </div>
        <div data-reveal="right">
          <div class="video" data-youtube="{{ c.psiquemagia.video.youtube | youtubeId }}" data-title="{{ c.psiquemagia.video.titulo | texto }}">
            <img src="https://i.ytimg.com/vi/{{ c.psiquemagia.video.youtube | youtubeId }}/hqdefault.jpg" width="480" height="360" alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.psiquemagia.video.boton | texto }}</span></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow center" data-reveal>{{ c.descubre_poco_mas.antetitulo | texto }}</span>
        <h2 class="h2" data-reveal style="--d:.1s">{{ c.descubre_poco_mas.titulo | titulo }}</h2>
        <p class="lead" data-reveal style="--d:.2s">{{ c.descubre_poco_mas.entradilla | md }}</p>
      </div>
      <div class="wrap-narrow" data-reveal>
        <div class="video" data-video="../assets/media/descubre-mi-trabajo.mp4">
          <img {{ c.descubre_poco_mas.video.portada | img }} alt="" loading="lazy">
          <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.descubre_poco_mas.video.titulo | texto }}</span></button>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
