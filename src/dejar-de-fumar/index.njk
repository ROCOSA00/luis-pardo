{% extends "layouts/base.njk" %}
{% block head %}
<title>{{ c.seo.titulo | texto }}</title>
<meta name="description" content="{{ c.seo.descripcion | texto }}">
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
<meta property="og:title" content="{{ c.seo.titulo_redes | texto }}">
<meta property="og:image" content="{{ sitio.url }}{{ c.seo.imagen_redes }}">
{% endblock %}
{% block main %}
<main id="main">
  <section class="page-hero">
    <div class="hero-bg"><img {{ c.cabecera.imagen | img }} alt="" fetchpriority="high" style="object-position:center 20%"></div>
    <div class="wrap">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Migas de pan" data-reveal><a href="../">Inicio</a><span aria-hidden="true">/</span><a href="../curso/">Tu mente</a><span aria-hidden="true">/</span><span>Dejar de fumar</span></nav>
        <span class="eyebrow" data-reveal>{{ c.cabecera.antetitulo | texto }}</span>
        <h1 class="display" data-reveal style="--d:.1s">{{ c.cabecera.titulo | titulo }}</h1>
        <p class="lead" data-reveal style="--d:.2s">{{ c.cabecera.entradilla | md }}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="grid-2">
        <div data-reveal="left">
          <div class="video vertical" data-video="../assets/media/dejar-de-fumar.mp4">
            <img {{ c.por_que_casi.video.portada | img }} alt="" loading="lazy">
            <button class="video-play" type="button"><span class="ring"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="label">{{ c.por_que_casi.video.titulo | texto }}</span></button>
          </div>
        </div>
        <div class="stack-lg" id="dossier">
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.por_que_casi.antetitulo | texto }}</span>
            <h2 class="h2" data-reveal style="--d:.1s">{{ c.por_que_casi.titulo | titulo }}</h2>
            <p class="lead" data-reveal style="--d:.2s">{{ c.por_que_casi.entradilla | md }}</p>
          </div>
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.por_que_casi.antetitulo_2 | texto }}</span>
            <p class="muted" data-reveal style="--d:.25s">{{ c.por_que_casi.texto | md }}</p>
            <div class="row" data-reveal style="--d:.3s">
              <a class="btn btn-gold btn-lg" {{ c.por_que_casi.boton.enlace | enlace }} download>{{ c.por_que_casi.boton.texto | texto }}</a>
            </div>
          </div>
          <div class="stack">
            <span class="eyebrow" data-reveal>{{ c.por_que_casi.antetitulo_3 | texto }}</span>
            <p class="muted" data-reveal style="--d:.35s">{{ c.por_que_casi.texto_2 | md }}</p>
            <div class="row" data-reveal style="--d:.4s">
              <a class="btn btn-whatsapp btn-lg" href="{{ c.por_que_casi.boton_2.mensaje | whatsapp(ajustes.whatsapp) }}" target="_blank" rel="noopener">{{ c.por_que_casi.boton_2.texto | texto }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap-narrow center stack-lg" style="justify-items:center">
      <span class="eyebrow center" data-reveal>{{ c.mpm_personalizado_para.antetitulo | texto }}</span>
      <h2 class="h2" data-reveal style="--d:.1s">{{ c.mpm_personalizado_para.titulo | titulo }}</h2>
      <p class="lead" data-reveal style="--d:.2s">{{ c.mpm_personalizado_para.entradilla | md }}</p>
      <div class="row center" data-reveal style="--d:.3s"><a class="btn btn-ghost btn-lg" {{ c.mpm_personalizado_para.boton.enlace | enlace }}>{{ c.mpm_personalizado_para.boton.texto | texto }}</a></div>
    </div>
  </section>
</main>
{% endblock %}
